---
import BrandLogo from '../components/BrandLogo.astro';
import CommandPalette from '../components/CommandPalette.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  contentType?: string;
  image?: string;
  socialType?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  isHome?: boolean;
  fullBleed?: boolean;
  hideFooter?: boolean;
  sectionLabel?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  contentType = '页面',
  image = '/images/showcase/cluster-trio.jpg',
  socialType = 'website',
  published,
  updated,
  jsonLd,
  isHome = false,
  hideFooter = false,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: '首页' },
  { href: '/projects/', label: '项目' },
  { href: '/notes/', label: '笔记' },
  { href: '/knowledge/', label: '知识库' },
  { href: '/uses/', label: '工作台' },
  { href: '/about/', label: '关于' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
};

const pageTitle = isHome ? title : (title === 'Wanone' ? title : `${title} · Wanone`);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta data-pagefind-meta="type" content={contentType} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Wanone 工程笔记" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Wanone" />
    <meta property="og:type" content={socialType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('starlight-theme') ?? localStorage.getItem('wanone-theme');
        const theme = saved === 'dark' ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>

    <header class="site-nav" data-site-nav>
      <div class="page-shell site-nav__inner">
        <BrandLogo />

        <nav class="site-nav__links" aria-label="主导航">
          {navLinks.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                class:list={['nav-link', active && 'is-active']}
                href={item.href}
                aria-current={active ? 'page' : undefined}
                data-sound="tick"
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <div class="site-nav__actions">
          <button type="button" class="nav-tool nav-tool--search" data-command-trigger aria-label="搜索站内内容" data-sound="tick">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <kbd>⌘K</kbd>
          </button>

          <button type="button" class="nav-tool" data-sound-toggle aria-pressed="true" title="开关音效" aria-label="开关音效">
            <span class="sound-dot" data-sound-dot></span>
            <span class="nav-tool__label" data-sound-label>音效</span>
          </button>

          <button type="button" class="nav-tool nav-tool--icon" data-theme-toggle aria-pressed="false" title="切换主题" aria-label="切换深浅主题">
            <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>

          <span class="nav-sep" aria-hidden="true"></span>

          <a class:list={['nav-cv', isActive('/resume/') && 'is-active']} href="/resume/" data-sound="pop">简历</a>

          <button
            type="button"
            class="nav-tool site-nav__menu-btn"
            data-mobile-menu-toggle
            aria-expanded="false"
            aria-controls="mobileNavDrawer"
          >
            菜单
          </button>
        </div>
      </div>

      <div class="mobile-drawer" id="mobileNavDrawer" data-mobile-drawer hidden>
        <div class="page-shell mobile-drawer__inner">
          <nav class="mobile-drawer__links" aria-label="移动端主导航">
            {navLinks.map((item) => {
              const active = isActive(item.href);
              return (
                <a class:list={['mobile-link', active && 'is-active']} href={item.href}>
                  {item.label}
                </a>
              );
            })}
            <a class="mobile-link" href="/resume/">简历</a>
            <a class="mobile-link" href="/archive/">归档</a>
            <a class="mobile-link" href="/tags/">标签</a>
          </nav>
        </div>
      </div>
    </header>

    <main id="main-content" class="site-main">
      <div class="page-shell">
        <slot />
      </div>
    </main>

    {!hideFooter && (
      <footer class="site-footer">
        <div class="page-shell site-footer__inner">
          <p class="site-footer__copy">© {new Date().getFullYear()} 万志成 Wanone</p>
          <nav class="site-footer__nav" aria-label="页脚导航">
            <a href="/projects/">项目</a>
            <a href="/notes/">笔记</a>
            <a href="/knowledge/">知识库</a>
            <a href="/uses/">工作台</a>
            <a href="/archive/">归档</a>
            <a href="/tags/">标签</a>
            <a href="/links/">友链</a>
            <a href="/rss.xml">RSS</a>
            <a href="https://github.com/wanone111" target="_blank" rel="me noreferrer">GitHub ↗</a>
          </nav>
        </div>
      </footer>
    )}

    <CommandPalette />
    <slot name="overlay" />

    <script>
      import { isSoundEnabled, playSound, setSoundEnabled } from '../lib/sound';

      const soundBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]'));
      const syncSoundUI = () => {
        const on = isSoundEnabled();
        soundBtns.forEach((btn) => {
          btn.setAttribute('aria-pressed', String(on));
          btn.setAttribute('title', on ? '点击关闭音效' : '点击开启音效');
          const dot = btn.querySelector<HTMLElement>('[data-sound-dot]');
          if (dot) dot.classList.toggle('is-off', !on);
        });
      };
      syncSoundUI();

      soundBtns.forEach((btn) => {
        if (btn.dataset.ready === 'true') return;
        btn.dataset.ready = 'true';
        btn.addEventListener('click', () => {
          const next = !isSoundEnabled();
          setSoundEnabled(next);
          syncSoundUI();
          if (next) playSound('chime');
        });
      });

      const themeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'));
      const syncThemeUI = (theme: string) => {
        const isDark = theme === 'dark';
        themeBtns.forEach((btn) => {
          btn.setAttribute('aria-pressed', String(isDark));
          btn.setAttribute('title', isDark ? '切换到浅色模式' : '切换到深色模式');
        });
      };
      syncThemeUI(document.documentElement.dataset.theme ?? 'light');

      themeBtns.forEach((btn) => {
        if (btn.dataset.ready === 'true') return;
        btn.dataset.ready = 'true';
        btn.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('wanone-theme', next);
          localStorage.setItem('starlight-theme', next);
          syncThemeUI(next);
          playSound('tick');
          window.dispatchEvent(new CustomEvent('wanone:themechange', { detail: { theme: next } }));
        });
      });

      document.querySelectorAll<HTMLElement>('[data-sound]').forEach((el) => {
        if (el.dataset.soundBound === 'true') return;
        el.dataset.soundBound = 'true';
        el.addEventListener('click', () => {
          const kind = el.dataset.sound as 'tick' | 'pop' | 'close' | 'chime' | 'thud';
          if (kind) playSound(kind);
        });
      });

      const menuBtn = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
      const drawer = document.querySelector<HTMLElement>('[data-mobile-drawer]');
      if (menuBtn && drawer) {
        const setOpen = (open: boolean) => {
          menuBtn.setAttribute('aria-expanded', String(open));
          menuBtn.textContent = open ? '收起' : '菜单';
          drawer.hidden = !open;
        };
        menuBtn.addEventListener('click', () => {
          const open = Boolean(drawer.hidden);
          setOpen(open);
          playSound(open ? 'pop' : 'close');
        });
        drawer.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 12px;
    left: 12px;
    transform: translateY(-200%);
    border-radius: var(--radius-pill);
    padding: 8px 14px;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }
  .skip-link:focus {
    transform: translateY(0);
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--color-bg-glass);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
  }
  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 60px;
    padding-inline: 24px;
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .nav-link {
    padding: 6px 12px;
    border-radius: 8px;
    color: var(--color-text-muted);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-surface-soft);
  }
  .nav-link.is-active {
    color: var(--color-text);
    background: var(--color-surface-soft);
    font-weight: 650;
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }
  .nav-tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 32px;
    padding: 0 9px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-text-muted);
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .nav-tool:hover {
    background: var(--color-surface-soft);
    color: var(--color-text);
  }
  .nav-tool--icon {
    width: 32px;
    padding: 0;
  }
  .nav-tool--search kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-subtle);
  }
  .sound-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-status-on);
  }
  .sound-dot.is-off {
    background: var(--color-status-off);
  }

  .icon-sun { display: none; }
  .icon-moon { display: block; }
  :global(:root[data-theme='dark']) .icon-sun { display: block; }
  :global(:root[data-theme='dark']) .icon-moon { display: none; }

  .nav-sep {
    width: 1px;
    height: 16px;
    margin-inline: 4px;
    background: var(--color-border);
  }
  .nav-cv {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 13px;
    border-radius: 8px;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--transition-fast);
  }
  .nav-cv:hover {
    opacity: 0.88;
  }
  .site-nav__menu-btn {
    display: none;
  }

  .mobile-drawer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .mobile-drawer__inner {
    padding: 14px 20px 18px;
  }
  .mobile-drawer__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .mobile-link {
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 13px;
    font-weight: 550;
    text-align: center;
    text-decoration: none;
  }
  .mobile-link.is-active {
    background: var(--color-surface-soft);
    border-color: var(--color-border-strong);
    font-weight: 700;
  }

  .site-main {
    min-height: calc(100vh - 60px - 80px);
    padding: 32px 24px 72px;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    padding: 20px 24px;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .site-footer__copy {
    font-size: 12.5px;
    color: var(--color-text-muted);
  }
  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .site-footer__nav a {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .site-footer__nav a:hover {
    color: var(--color-text);
  }

  @media (max-width: 860px) {
    .site-nav__links {
      display: none;
    }
    .site-nav__menu-btn {
      display: inline-flex;
    }
  }
  @media (max-width: 560px) {
    .site-nav__inner {
      padding-inline: 16px;
    }
    .nav-tool__label,
    .nav-tool--search kbd,
    .nav-sep,
    .nav-cv {
      display: none;
    }
    .site-main {
      padding: 20px 16px 56px;
    }
    .mobile-drawer__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
