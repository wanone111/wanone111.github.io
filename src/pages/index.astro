---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LidarSandbox from '../components/LidarSandbox.astro';
import { byFeaturedOrder, byNewest, formatDate, isPublic } from '../lib/content';

const projects = (await getCollection('projects', isPublic)).sort(byFeaturedOrder);
const posts = (await getCollection('blog', isPublic)).sort(byNewest);

const introduction = '集美大学微电子科学与技术本科生。做嵌入式软件、ROS 2 机器人、FPGA 视频链路和边缘 AI 部署。';
const siteUrl = Astro.site ?? new URL('https://wanone111.github.io');
const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '万志成',
  alternateName: 'Wanone',
  url: siteUrl.href,
  sameAs: ['https://github.com/wanone111'],
  knowsAbout: ['嵌入式系统', '机器人系统', 'ROS 2', 'PX4', 'FPGA', 'PYNQ', '边缘 AI'],
};

const hardwareSlides = [
  {
    id: 'trio',
    label: '三机合照',
    src: '/images/showcase/cluster-trio.jpg',
    caption: '左：Tang Primer 20K 六足 · 中：BX72 麦轮小车 · 右：Tang Primer 25K 四足',
  },
  {
    id: 'hexapod',
    label: '六足 18 路',
    src: '/images/showcase/hexapod-front.jpg',
    caption: '六足机器人正面：RealSense 深度相机 + Orange Pi + Tang Primer 20K',
  },
  {
    id: 'wheeled',
    label: 'BX72 轮式',
    src: '/images/showcase/wheeled-front.jpg',
    caption: 'BX72 全向麦轮平台：OV5647 相机支架、N10 雷达与四轮编码器闭环',
  },
  {
    id: 'quadruped',
    label: '四足 8 路',
    src: '/images/showcase/quadruped.jpg',
    caption: 'Tang Primer 25K 四足样机：3D 打印结构件 + 8 路舵机 PWM + LD19 雷达接口',
  },
];

const domainColorClass = (cat = '') => {
  const c = cat.toLowerCase();
  if (c.includes('fpga') || c.includes('hls') || c.includes('verilog')) return 'd-fpga';
  if (c.includes('robot') || c.includes('机器人') || c.includes('算法')) return 'd-robot';
  if (c.includes('embed') || c.includes('嵌入式')) return 'd-embed';
  return 'd-tool';
};
---

<BaseLayout
  title="Wanone · 万志成的工程实验台"
  description={introduction}
  canonicalPath="/"
  contentType="首页"
  image="/images/showcase/cluster-trio.jpg"
  jsonLd={homeJsonLd}
  isHome
>
  <section class="hero">
    <div class="hero__copy">
      <span class="status-pill">
        <span class="pulse-dot" aria-hidden="true"></span>
        BX72 轮式 · 六足 · 无人机
      </span>
      <h1>
        你好，我是万志成。<br />
        我构建<span class="hero-hl">嵌入式、机器人</span><br />
        <span class="hero-hl">与边缘 AI</span> 系统。
      </h1>
      <p class="hero__lead">{introduction}</p>
      <div class="hero__actions">
        <a class="btn" href="/projects/" data-sound="pop">全部项目 →</a>
        <a class="btn btn--ghost" href="#pid-lab" data-sound="tick">PID 实验</a>
      </div>
      <div class="hero__stats">
        <div><strong>{projects.length}</strong><span>项目</span></div>
        <div><strong>{posts.length}</strong><span>笔记</span></div>
        <div><strong>42.4×</strong><span>时序裕量优化</span></div>
      </div>
    </div>

    <div class="hero__visual">
      <LidarSandbox />
    </div>
  </section>

  <div class="section-head">
    <h2>作品与实验</h2>
    <a class="text-link" href="/projects/" data-sound="tick">全部项目 →</a>
  </div>

  <section class="bento">
    <article class="tile d-robot span-2 row-2 gallery-tile" data-photo-gallery>
      <div class="tile__top">
        <span class="tile__label"><span class="dot"></span>FPGA 异构机器人集群</span>
      </div>
      <div class="photo-frame">
        {hardwareSlides.map((slide, i) => (
          <img
            src={slide.src}
            alt={slide.caption}
            class:list={['photo-frame__img', i === 0 && 'is-active']}
            data-slide={slide.id}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))}
        <div class="photo-tabs" role="tablist" aria-label="切换样机实物图">
          {hardwareSlides.map((slide, i) => (
            <button
              type="button"
              class:list={['photo-tab', i === 0 && 'is-active']}
              data-slide-btn={slide.id}
              data-caption={slide.caption}
              data-sound="tick"
            >
              {slide.label}
            </button>
          ))}
        </div>
      </div>
      <div class="tile__body-row">
        <div>
          <h3>轮式、六足与四足实机</h3>
          <p class="photo-caption" data-slide-caption>{hardwareSlides[0].caption}</p>
        </div>
        <a class="circle-arrow" href="/projects/hexapod-robot-cooperative-mapping/" aria-label="查看项目详情" data-sound="pop">↗</a>
      </div>
    </article>

    <article class="tile d-fpga metric-tile">
      <div class="tile__top">
        <span class="tile__label"><span class="dot"></span>BX72 · PnR 时序优化</span>
      </div>
      <div class="metric-tile__val">
        <strong>42.4×</strong>
        <span>setup 裕量提升</span>
      </div>
      <p>Logic -4.65%（-2,296），Register -2.61%。</p>
    </article>

    <article class="tile d-embed metric-tile">
      <div class="tile__top">
        <span class="tile__label"><span class="dot"></span>PYNQ-Z2 · HDMI 直通</span>
      </div>
      <div class="metric-tile__val">
        <strong>1080p<small>@60Hz</small></strong>
        <span>PC 信号稳定直通</span>
      </div>
      <p>OV5647 RAW10 经 Bayer 处理与 DDR3 双缓冲输出。</p>
    </article>

    <article class="tile d-robot span-2 hexapod-tile" data-hexapod-toy>
      <div class="tile__top">
        <span class="tile__label"><span class="dot"></span>六足 18 路 PWM 步态</span>
      </div>
      <div class="hexapod-wrap">
        <div class="hexapod-ctrl">
          <h3>六足三角步态遥控</h3>
          <p>Tang Primer 20K + PCA9685 预设动作。</p>
          <div class="gait-btns">
            <button type="button" class="gait-btn is-active" data-gait="forward" data-sound="tick">前进</button>
            <button type="button" class="gait-btn" data-gait="backward" data-sound="tick">后退</button>
            <button type="button" class="gait-btn" data-gait="left" data-sound="tick">左转</button>
            <button type="button" class="gait-btn" data-gait="right" data-sound="tick">右转</button>
            <button type="button" class="gait-btn" data-gait="strafe" data-sound="tick">平移</button>
            <button type="button" class="gait-btn gait-btn--stop" data-gait="stop" data-sound="thud">急停</button>
          </div>
          <p class="gait-status mono" data-gait-status>CMD: FORWARD · 18 CH PWM</p>
        </div>
        <div class="hexapod-stage">
          <canvas data-hexapod-canvas aria-label="六足机器人三角步态俯视动画"></canvas>
        </div>
      </div>
    </article>

    <article class="tile d-fpga span-2 row-2 compare-tile" data-map-compare>
      <div class="tile__top">
        <span class="tile__label"><span class="dot"></span>全局 SLAM / FPGA 局部栅格</span>
      </div>
      <h3>两级实时建图对比</h3>
      <div class="compare-stage" data-compare-stage>
        <img src="/images/showcase/slam-global.jpg" alt="Jetson 全局 SLAM 地图" class="compare-img compare-img--base" loading="lazy" />
        <div class="compare-overlay" data-compare-overlay style="clip-path: inset(0 50% 0 0);">
          <img src="/images/showcase/slam-local.jpg" alt="FPGA 64×64 局部滚动栅格" class="compare-img" loading="lazy" />
        </div>
        <div class="compare-handle" data-compare-handle style="left: 50%;" aria-hidden="true">
          <span>⇄</span>
        </div>
        <span class="compare-badge compare-badge--left mono">FPGA 64×64</span>
        <span class="compare-badge compare-badge--right mono">Jetson SLAM</span>
        <input
          type="range"
          class="compare-range"
          min="5"
          max="95"
          value="50"
          aria-label="拖动对比 FPGA 局部栅格与 Jetson 全局地图"
          data-compare-input
        />
      </div>
      <div class="tile__foot-bar">
        <span class="mono">64×64 格 · 50 mm/格</span>
        <a class="text-link" href="/projects/hexapod-robot-cooperative-mapping/" data-sound="pop">项目详情 ↗</a>
      </div>
    </article>

    <article class="tile d-embed span-2 drone-tile" data-drone-toggle>
      <div class="tile__top">
        <span class="tile__label"><span class="dot"></span>室内无人机</span>
        <div class="mini-switch">
          <button type="button" class="mini-pill is-active" data-drone-src="/images/showcase/drone-front.jpg" data-sound="tick">正面</button>
          <button type="button" class="mini-pill" data-drone-src="/images/showcase/drone-top.jpg" data-sound="tick">机载硬件</button>
        </div>
      </div>
      <div class="drone-grid">
        <div class="drone-photo">
          <img src="/images/showcase/drone-front.jpg" alt="室内无人机实物" data-drone-img loading="lazy" />
        </div>
        <div class="drone-info">
          <h3>室内无人机自主飞行控制</h3>
          <p>前置深度相机 + 机载计算 + PX4 / MAVROS，仿真完成 1 m 起飞与 10 s 悬停。</p>
          <div class="tile__foot-bar">
            <span class="tag">PX4 / ROS 2</span>
            <a class="circle-arrow" href="/projects/indoor-autonomous-drone/" aria-label="查看无人机项目" data-sound="pop">↗</a>
          </div>
        </div>
      </div>
    </article>

    <article class="tile d-fpga span-2 pipe-tile">
      <div class="tile__top">
        <span class="tile__label"><span class="dot"></span>异构硬件视频链路</span>
        <a class="text-link" href="/projects/heterogeneous-video-pipeline/" data-sound="pop">详情 ↗</a>
      </div>
      <div class="pipe">
        <div class="pipe-node"><strong>HDMI</strong><small>输入</small></div>
        <div class="pipe-link"></div>
        <div class="pipe-node"><strong>PYNQ-Z2</strong><small>TMDS</small></div>
        <div class="pipe-link"></div>
        <div class="pipe-node"><strong>UDP</strong><small>转发</small></div>
        <div class="pipe-link"></div>
        <div class="pipe-node"><strong>310B</strong><small>YOLO</small></div>
        <div class="pipe-link"></div>
        <div class="pipe-node"><strong>Player</strong><small>输出</small></div>
      </div>
    </article>

    <article class="tile d-robot span-2 row-2 pid-tile" id="pid-lab" data-pid-lab>
      <div class="tile__top">
        <span class="tile__label"><span class="dot"></span>PID 阶跃响应</span>
      </div>
      <div class="pid-layout">
        <div class="pid-controls">
          <label><span>Kp <b data-kp-val>2.0</b></span><input type="range" min="0" max="12" step="0.1" value="2" data-kp /></label>
          <label><span>Ki <b data-ki-val>0.50</b></span><input type="range" min="0" max="6" step="0.05" value="0.5" data-ki /></label>
          <label><span>Kd <b data-kd-val>0.30</b></span><input type="range" min="0" max="4" step="0.05" value="0.3" data-kd /></label>
          <div class="pid-presets">
            <button type="button" data-preset="2,0,0" data-sound="tick">只有 P</button>
            <button type="button" data-preset="8,0.4,0.1" data-sound="tick">振荡</button>
            <button type="button" data-preset="4,1.6,1.4" data-sound="tick">较好</button>
          </div>
          <div class="pid-readout">
            <div><small>超调</small><strong data-pid-os>–</strong></div>
            <div><small>调节时间</small><strong data-pid-ts>–</strong></div>
          </div>
        </div>
        <div class="pid-canvas-wrap">
          <canvas data-pid-canvas aria-label="PID 阶跃响应曲线"></canvas>
        </div>
      </div>
      <div class="tile__foot-bar">
        <span class="mono">±2% 稳态带</span>
        <a class="text-link" href="/notes/algorithms/pid-control-basics/" data-sound="pop">PID 笔记 →</a>
      </div>
    </article>

    <article class="tile d-embed board-tile">
      <div class="tile__top">
        <span class="tile__label"><span class="dot"></span>Tang Primer 20K</span>
      </div>
      <div class="board-photo">
        <img src="/images/showcase/tang-20k.jpg" alt="Tang Primer 20K 六足控制板" loading="lazy" />
      </div>
      <div class="tile__body-row">
        <h3>六足硬件控制板</h3>
        <a class="circle-arrow" href="/projects/hexapod-robot-cooperative-mapping/" aria-label="查看协同建图项目" data-sound="pop">↗</a>
      </div>
    </article>

    <article class="tile d-tool stack-tile">
      <div class="tile__top">
        <span class="tile__label"><span class="dot"></span>技术栈</span>
        <a class="text-link" href="/about/" data-sound="tick">关于 ↗</a>
      </div>
      <div class="stack-chips">
        <span class="schip d-robot">ROS 2</span>
        <span class="schip d-robot">Nav2 / SLAM</span>
        <span class="schip d-robot">PX4 / MAVROS</span>
        <span class="schip d-fpga">Verilog RTL</span>
        <span class="schip d-fpga">Vitis HLS</span>
        <span class="schip d-fpga">Ascend 310B</span>
        <span class="schip d-embed">STM32</span>
        <span class="schip d-embed">Tang Primer</span>
        <span class="schip d-tool">C++ / Linux</span>
        <span class="schip d-tool">Astro</span>
      </div>
    </article>

    <article class="tile d-tool span-2 notes-tile">
      <div class="tile__top">
        <span class="tile__label"><span class="dot"></span>最新笔记</span>
        <a class="text-link" href="/notes/" data-sound="tick">全部 {posts.length} 篇 →</a>
      </div>
      <div class="notes-mini-list">
        {posts.slice(0, 4).map((post) => (
          <a class:list={['note-mini-row', domainColorClass(post.data.category)]} href={`/notes/${post.data.slug}/`} data-sound="pop">
            <span class="note-mini-row__title">
              <span class="dot"></span>
              {post.data.title}
            </span>
            <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time>
          </a>
        ))}
      </div>
    </article>
  </section>
</BaseLayout>

<script>
  import { playSound } from '../lib/sound';

  // 1. Bento 卡片鼠标聚光效果
  document.querySelectorAll<HTMLElement>('.tile').forEach((tile) => {
    tile.addEventListener('pointermove', (e) => {
      const r = tile.getBoundingClientRect();
      tile.style.setProperty('--mx', `${e.clientX - r.left}px`);
      tile.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });

  // 2. 实物图集切换
  document.querySelectorAll<HTMLElement>('[data-photo-gallery]').forEach((root) => {
    const imgs = [...root.querySelectorAll<HTMLImageElement>('[data-slide]')];
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-slide-btn]')];
    const caption = root.querySelector<HTMLElement>('[data-slide-caption]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.slideBtn;
        btns.forEach((b) => b.classList.toggle('is-active', b === btn));
        imgs.forEach((img) => img.classList.toggle('is-active', img.dataset.slide === id));
        if (caption && btn.dataset.caption) caption.textContent = btn.dataset.caption;
      });
    });
  });

  // 3. 无人机正/斜视图切换
  document.querySelectorAll<HTMLElement>('[data-drone-toggle]').forEach((root) => {
    const img = root.querySelector<HTMLImageElement>('[data-drone-img]');
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-drone-src]')];
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!img || !btn.dataset.droneSrc) return;
        img.src = btn.dataset.droneSrc;
        btns.forEach((b) => b.classList.toggle('is-active', b === btn));
      });
    });
  });

  // 4. 全局 SLAM vs FPGA 局部栅格滑块对比
  document.querySelectorAll<HTMLElement>('[data-map-compare]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-compare-input]');
    const overlay = root.querySelector<HTMLElement>('[data-compare-overlay]');
    const handle = root.querySelector<HTMLElement>('[data-compare-handle]');
    if (!input || !overlay || !handle) return;
    const sync = () => {
      const pct = Number(input.value);
      overlay.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
      handle.style.left = `${pct}%`;
    };
    input.addEventListener('input', sync);
    sync();
  });

  // 5. 六足 18 路舵机三角步态动画
  document.querySelectorAll<HTMLElement>('[data-hexapod-toy]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-hexapod-canvas]');
    const statusEl = root.querySelector<HTMLElement>('[data-gait-status]');
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-gait]')];
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let mode = 'forward';
    let phase = 0;
    const labels: Record<string, string> = {
      forward: 'CMD: FORWARD · 18 CH PWM ACTIVE',
      backward: 'CMD: BACKWARD · 18 CH PWM ACTIVE',
      left: 'CMD: TURN_LEFT · 18 CH PWM ACTIVE',
      right: 'CMD: TURN_RIGHT · 18 CH PWM ACTIVE',
      strafe: 'CMD: STRAFE · 18 CH PWM ACTIVE',
      stop: 'CMD: E-STOP · PWM OUTPUT DISABLED',
    };

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        mode = btn.dataset.gait ?? 'forward';
        btns.forEach((b) => b.classList.toggle('is-active', b === btn));
        if (statusEl) statusEl.textContent = labels[mode] ?? '';
      });
    });

    let w = 1, h = 1;
    const fit = () => {
      const r = canvas.getBoundingClientRect();
      w = Math.max(1, r.width); h = Math.max(1, r.height);
      const d = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * d); canvas.height = Math.round(h * d);
      ctx.setTransform(d, 0, 0, d, 0, 0);
    };
    fit();
    new ResizeObserver(fit).observe(canvas);

    // 六条腿：左前/左中/左后，右前/右中/右后；tripod 组 0 或 1
    const legs = [
      { side: -1, y: -22, baseAngle: -2.45, group: 0 },
      { side: -1, y: 0, baseAngle: Math.PI, group: 1 },
      { side: -1, y: 22, baseAngle: 2.45, group: 0 },
      { side: 1, y: -22, baseAngle: -0.68, group: 1 },
      { side: 1, y: 0, baseAngle: 0, group: 0 },
      { side: 1, y: 22, baseAngle: 0.68, group: 1 },
    ];

    const drawHex = () => {
      const s = getComputedStyle(document.documentElement);
      const colRobot = s.getPropertyValue('--color-robot').trim() || '#0d9488';
      const colEmbed = s.getPropertyValue('--color-embed').trim() || '#ea580c';
      const colText = s.getPropertyValue('--color-text').trim() || '#181715';
      const colMuted = s.getPropertyValue('--color-text-muted').trim() || '#6c675e';
      const colSurf = s.getPropertyValue('--color-surface').trim() || '#ffffff';

      if (mode !== 'stop') phase += 0.085;
      ctx.clearRect(0, 0, w, h);

      const cx = w / 2;
      const cy = h / 2;
      const bodySwayX = mode === 'strafe' ? Math.sin(phase) * 4 : 0;
      const bodySwayY = (mode === 'forward' || mode === 'backward') ? Math.sin(phase * 2) * 1.5 : 0;
      const bodyRot = mode === 'left' ? -Math.sin(phase) * 0.08 : mode === 'right' ? Math.sin(phase) * 0.08 : 0;

      ctx.save();
      ctx.translate(cx + bodySwayX, cy + bodySwayY);
      ctx.rotate(bodyRot);

      // 绘制 6 条机械腿
      legs.forEach((leg) => {
        const p = phase + leg.group * Math.PI;
        let swing = 0;
        let lift = 0;
        if (mode !== 'stop') {
          const dir = mode === 'backward' ? -1 : 1;
          if (mode === 'left') swing = Math.sin(p) * 0.34;
          else if (mode === 'right') swing = -Math.sin(p) * 0.34;
          else if (mode === 'strafe') swing = Math.sin(p) * 0.25 * leg.side;
          else swing = Math.sin(p) * 0.32 * leg.side * dir;
          lift = Math.max(0, Math.cos(p));
        }

        const hipX = leg.side * 19;
        const hipY = leg.y;
        const a = leg.baseAngle + swing;
        const kneeLen = 22 + lift * 4;
        const footLen = 40 + lift * 6;
        const kx = hipX + Math.cos(a) * kneeLen;
        const ky = hipY + Math.sin(a) * kneeLen;
        const fx = hipX + Math.cos(a) * footLen;
        const fy = hipY + Math.sin(a) * footLen;

        ctx.strokeStyle = lift > 0.3 ? colRobot : colMuted;
        ctx.lineWidth = lift > 0.3 ? 3 : 2.2;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(hipX, hipY);
        ctx.lineTo(kx, ky);
        ctx.lineTo(fx, fy);
        ctx.stroke();

        // 关节圆点
        ctx.fillStyle = lift > 0.3 ? colRobot : colSurf;
        ctx.strokeStyle = colText;
        ctx.lineWidth = 1.3;
        ctx.beginPath(); ctx.arc(kx, ky, 3, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

        // 足端触地光圈
        ctx.fillStyle = mode === 'stop' ? colEmbed : (lift > 0.3 ? colRobot : colText);
        ctx.beginPath(); ctx.arc(fx, fy, lift > 0.3 ? 4 : 3, 0, Math.PI * 2); ctx.fill();
      });

      // 六边形机身
      ctx.fillStyle = colSurf;
      ctx.strokeStyle = colText;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.roundRect(-20, -30, 40, 60, 12);
      ctx.fill();
      ctx.stroke();

      // 前置深度相机条
      ctx.fillStyle = mode === 'stop' ? colEmbed : colRobot;
      ctx.beginPath();
      ctx.roundRect(-13, -34, 26, 6, 3);
      ctx.fill();

      // 中心核心 LED
      ctx.fillStyle = mode === 'stop' ? colEmbed : colRobot;
      ctx.beginPath(); ctx.arc(0, 0, 4, 0, Math.PI * 2); ctx.fill();

      ctx.restore();
      requestAnimationFrame(drawHex);
    };
    requestAnimationFrame(drawHex);
  });

  // 6. PID 阶跃响应交互实验室
  document.querySelectorAll<HTMLElement>('[data-pid-lab]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-pid-canvas]');
    const kp = root.querySelector<HTMLInputElement>('[data-kp]');
    const ki = root.querySelector<HTMLInputElement>('[data-ki]');
    const kd = root.querySelector<HTMLInputElement>('[data-kd]');
    const kpVal = root.querySelector<HTMLElement>('[data-kp-val]');
    const kiVal = root.querySelector<HTMLElement>('[data-ki-val]');
    const kdVal = root.querySelector<HTMLElement>('[data-kd-val]');
    const osEl = root.querySelector<HTMLElement>('[data-pid-os]');
    const tsEl = root.querySelector<HTMLElement>('[data-pid-ts]');
    if (!canvas || !kp || !ki || !kd) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const simulate = (Kp: number, Ki: number, Kd: number) => {
      const dt = 0.01, T = 12;
      let x = 0, v = 0, I = 0, prevE = 1;
      const ys: number[] = [];
      for (let s = 0; s <= T / dt; s++) {
        const e = 1 - x;
        I += e * dt;
        const D = (e - prevE) / dt;
        prevE = e;
        const u = Math.max(-60, Math.min(60, Kp * e + Ki * I + Kd * D));
        const a = u - 1.2 * v - x;
        v += a * dt;
        x += v * dt;
        if (!Number.isFinite(x)) x = 3;
        ys.push(x);
      }
      return { ys, dt, T };
    };

    const drawPid = () => {
      const r = canvas.getBoundingClientRect();
      const w = Math.max(1, r.width);
      const h = Math.max(1, r.height);
      const d = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * d);
      canvas.height = Math.round(h * d);
      ctx.setTransform(d, 0, 0, d, 0, 0);

      const s = getComputedStyle(document.documentElement);
      const colRobot = s.getPropertyValue('--color-robot').trim() || '#0d9488';
      const colMuted = s.getPropertyValue('--color-text-muted').trim() || '#6c675e';

      const Kp = Number(kp.value), Ki = Number(ki.value), Kd = Number(kd.value);
      if (kpVal) kpVal.textContent = Kp.toFixed(1);
      if (kiVal) kiVal.textContent = Ki.toFixed(2);
      if (kdVal) kdVal.textContent = Kd.toFixed(2);

      const { ys, dt, T } = simulate(Kp, Ki, Kd);
      const max = Math.max(...ys);
      const top = Math.min(3, Math.max(1.5, max + 0.15));
      const pad = { l: 30, r: 22, t: 14, b: 24 };
      const X = (t: number) => pad.l + (t / T) * (w - pad.l - pad.r);
      const Y = (val: number) => h - pad.b - (Math.max(-0.2, Math.min(top, val)) / top) * (h - pad.t - pad.b);

      ctx.clearRect(0, 0, w, h);
      ctx.strokeStyle = colMuted + '2a';
      ctx.lineWidth = 1;
      for (let t = 0; t <= T; t += 2) {
        ctx.beginPath(); ctx.moveTo(X(t), pad.t); ctx.lineTo(X(t), h - pad.b); ctx.stroke();
      }
      ctx.fillStyle = colMuted;
      ctx.font = '11px ui-monospace, Menlo, Consolas, monospace';
      for (let t = 0; t <= T; t += 4) ctx.fillText(`${t}s`, X(t) - 6, h - 7);
      ctx.fillText('1.0', 4, Y(1) + 4);

      ctx.fillStyle = colRobot + '1c';
      ctx.fillRect(pad.l, Y(1.02), w - pad.l - pad.r, Y(0.98) - Y(1.02));
      ctx.strokeStyle = colMuted;
      ctx.setLineDash([5, 4]);
      ctx.beginPath(); ctx.moveTo(pad.l, Y(1)); ctx.lineTo(w - pad.r, Y(1)); ctx.stroke();
      ctx.setLineDash([]);

      ctx.strokeStyle = colRobot;
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ys.forEach((y, i) => {
        const x = X(i * dt);
        i ? ctx.lineTo(x, Y(y)) : ctx.moveTo(x, Y(y));
      });
      ctx.stroke();

      const final = ys[ys.length - 1];
      let last = -1;
      ys.forEach((y, i) => { if (Math.abs(y - 1) > 0.02) last = i; });
      const os = Math.max(0, (max - 1) * 100);
      if (osEl) osEl.textContent = `${os.toFixed(1)}%`;
      if (tsEl) {
        tsEl.textContent = last >= ys.length - 1 || Math.abs(final - 1) > 0.02
          ? (Math.abs(final - 1) > 0.02 && Math.abs(final - 1) < 0.5 ? `稳态差 ${(Math.abs(1 - final) * 100).toFixed(0)}%` : '未收敛')
          : `${((last + 1) * dt).toFixed(1)} s`;
      }
    };

    [kp, ki, kd].forEach((el) => el.addEventListener('input', drawPid));
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const [a, b, c] = (btn.dataset.preset ?? '2,0.5,0.3').split(',');
        kp.value = a; ki.value = b; kd.value = c;
        drawPid();
        playSound('tick');
      });
    });

    new ResizeObserver(drawPid).observe(canvas);
    window.addEventListener('wanone:themechange', drawPid);
    drawPid();
  });
</script>

