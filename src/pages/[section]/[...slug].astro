---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isPublic, statusLabels } from '../../lib/content';

export async function getStaticPaths() {
  const [notes, projects] = await Promise.all([
    getCollection('blog', isPublic),
    getCollection('projects', isPublic),
  ]);
  return [...notes, ...projects].map((entry) => ({
    params: { section: entry.collection === 'blog' ? 'notes' : 'projects', slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'blog'> | CollectionEntry<'projects'>; }
const { entry } = Astro.props;
const { data } = entry;
const project = entry.collection === 'projects' ? entry.data : undefined;
const contentType = project ? '项目' : '文章';
const tocLabel = `${contentType}目录`;
const { Content, headings } = await render(entry);
const visibleHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const published = project ? data.created : data.published ?? data.created;

function readingMinutes(body = '') {
  const chineseCharacters = body.match(/[\u3400-\u9fff]/g)?.length ?? 0;
  const latinWords = body.replace(/[\u3400-\u9fff]/g, ' ').match(/\b[\w-]+\b/g)?.length ?? 0;
  return Math.max(1, Math.ceil(chineseCharacters / 350 + latinWords / 220));
}

const summaryItems = (project ? [
  { label: '项目状态', value: statusLabels[data.status] },
  { label: '时间范围', value: project.time_range ?? (data.created.getTime() === data.updated.getTime()
    ? formatDate(data.created)
    : `${formatDate(data.created)} — ${formatDate(data.updated)}`) },
  { label: '作者角色', value: project.role },
  { label: '硬件平台', value: project.hardware },
  { label: '软件环境', value: project.software },
  { label: '技术栈', value: (project.stack.length ? project.stack : data.tags).join(' · '), wide: true },
  { label: '核心结果', value: project.result, wide: true },
  { label: '验证方式', value: project.validation, wide: true },
  { label: '当前限制', value: project.limitations, wide: true },
  { label: '下一步', value: project.next_step, wide: true },
] : [
  { label: '问题', value: data.problem ?? data.description, wide: true },
  { label: '环境', value: data.environment ?? data.tags.join(' · '), wide: true },
  { label: '结论', value: data.conclusion, wide: true },
  { label: '状态', value: statusLabels[data.status] },
  { label: '适用版本', value: data.applicable_version },
  { label: '首次发布', value: formatDate(published) },
  { label: data.verified ? '最后验证' : '最后更新', value: formatDate(data.verified ?? data.updated) },
  { label: '预计阅读', value: `${readingMinutes(entry.body)} 分钟` },
]).filter(({ value }) => value?.trim());

const origin = Astro.site ?? Astro.url.origin;
const person = { '@type': 'Person', name: '万志成', alternateName: 'Wanone' };
const jsonLd = {
  '@context': 'https://schema.org',
  ...(project
    ? { '@type': 'CreativeWork', name: data.title, creator: person, dateCreated: published.toISOString() }
    : { '@type': 'TechArticle', headline: data.title, author: person, datePublished: published.toISOString() }),
  description: data.description,
  url: new URL(`/${Astro.params.section}/${data.slug}/`, origin).href,
  dateModified: data.updated.toISOString(),
  inLanguage: 'zh-CN',
  keywords: data.tags,
  image: data.cover ? new URL(data.cover, origin).href : undefined,
};
---

<BaseLayout title={data.title} description={data.description} contentType={contentType} image={data.cover} socialType="article" published={published} updated={data.updated} jsonLd={jsonLd}>
  <article class:list={['stack-xl', project ? 'project-detail' : 'article-detail']}>
    <header class={project ? 'stack-xl' : 'article-header'}>
      <div class={project ? 'project-header' : 'editorial-grid'}>
        {!project && (
          <div class="article-header__meta stack">
            <a href="/notes/">笔记 / 返回列表</a>
            <p>{data.category ?? '工程笔记'}</p>
            <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time>
          </div>
        )}
        <div class:list={['stack-lg', { 'article-header__body': !project }]}>
          {project && <p class="eyebrow">PROJECT · 工程档案 · 更新于 {formatDate(data.updated)}</p>}
          <h1>{data.title}</h1>
          <p class="lede">{data.description}</p>
          <div class="tag-list">{data.tags.map((tag) => project
            ? <span class="tag">{tag}</span>
            : <a class="tag" href={`/tags/#${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
        </div>
        {project && <a class="project-back" href="/projects/">返回项目</a>}
      </div>
      <dl class="engineering-summary" aria-label={`${contentType}工程摘要`}>
        {summaryItems.map((item) => (
          <div class:list={{ 'engineering-summary__wide': item.wide }}>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </header>
    <div class="article-layout">
      <aside class="article-rail" aria-label={tocLabel} data-article-rail>
        <div>
          <strong>{tocLabel}</strong>
        </div>
        {visibleHeadings.length > 0 ? (
          <nav aria-label={tocLabel}>
            <ol>
              {visibleHeadings.map((heading) => (
                <li data-depth={heading.depth}><a href={`#${heading.slug}`} data-heading-link={heading.slug}>{heading.text}</a></li>
              ))}
            </ol>
          </nav>
        ) : <p class="article-rail__empty">这篇内容暂时没有分节标题。</p>}
        <div class="article-rail__progress">
          <div><span>阅读进度</span><output data-reading-percent>0%</output></div>
          <progress max="100" value="0" data-reading-progress>0%</progress>
        </div>
        <button type="button" data-back-to-top>返回顶部</button>
      </aside>
      <div class="article-shell prose">
        {project?.slug === 'obsidian-astro-publishing' && (
          <aside aria-label="当前发布方式">
            <strong>当前发布方式</strong>
            <p>下文记录初版流程。现在本地运行 <code>npm run content:publish</code> 同步并构建，推送至 main 后由 GitHub Actions 构建并部署到 GitHub Pages。</p>
          </aside>
        )}
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-article-rail]').forEach((rail) => {
    const progress = rail.querySelector<HTMLProgressElement>('[data-reading-progress]');
    const output = rail.querySelector<HTMLOutputElement>('[data-reading-percent]');
    const links = [...rail.querySelectorAll<HTMLAnchorElement>('[data-heading-link]')];
    const topButton = rail.querySelector<HTMLButtonElement>('[data-back-to-top]');
    let frame = 0;

    const updateProgress = () => {
      frame = 0;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const value = scrollable > 0 ? Math.min(100, Math.max(0, Math.round((window.scrollY / scrollable) * 100))) : 100;
      if (progress) progress.value = value;
      if (output) output.value = `${value}%`;
    };
    const requestProgress = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateProgress);
    };
    updateProgress();
    window.addEventListener('scroll', requestProgress, { passive: true });
    window.addEventListener('resize', requestProgress);

    if ('IntersectionObserver' in window && links.length > 0) {
      const headingById = new Map(links.map((link) => [link.dataset.headingLink ?? '', link]));
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        links.forEach((link) => link.removeAttribute('aria-current'));
        headingById.get(visible.target.id)?.setAttribute('aria-current', 'location');
      }, { rootMargin: '-18% 0px -68% 0px' });
      headingById.forEach((_, id) => {
        const heading = document.getElementById(id);
        if (heading) observer.observe(heading);
      });
    }

    topButton?.addEventListener('click', () => window.scrollTo({
      top: 0,
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
    }));
  });

  document.querySelectorAll<HTMLElement>('.article-detail .article-shell pre').forEach((codeBlock, index) => {
    if (codeBlock.dataset.copyReady === 'true') return;
    codeBlock.dataset.copyReady = 'true';
    codeBlock.tabIndex = 0;
    const shell = document.createElement('div');
    shell.className = 'code-copy-shell';
    codeBlock.before(shell);
    shell.append(codeBlock);
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy-button';
    button.textContent = '复制';
    button.setAttribute('aria-label', `复制第 ${index + 1} 个代码块`);
    shell.append(button);
    button.addEventListener('click', async () => {
      const code = codeBlock.querySelector('code')?.textContent ?? codeBlock.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = '已复制';
      } catch {
        button.textContent = '复制失败，请手动选择';
      }
      window.setTimeout(() => { button.textContent = '复制'; }, 1800);
    });
  });
</script>

<style>
  .article-header { display: grid; gap: var(--space-7); border-bottom: 1px solid var(--color-border-strong); padding-block: clamp(3.5rem, 8vw, 7rem) var(--space-7); }
  .article-header__meta { grid-column: 1 / span 3; color: var(--color-text-muted); font: 600 .74rem/1.6 var(--font-mono); }
  .article-header__meta a { color: var(--color-accent-strong); }
  .article-header__body { grid-column: 4 / -1; }
  .article-header__body h1 { max-width: 16ch; font-size: clamp(2.8rem, 7vw, 6.5rem); }
  :global(.code-copy-shell) { position: relative; margin-block: 1.5rem; }
  :global(.code-copy-shell pre) { margin-block: 0; padding-top: 3.2rem; }
  :global(.code-copy-button) { position: absolute; z-index: 2; top: .65rem; right: .65rem; max-width: calc(100% - 1.3rem); overflow: hidden; border: 1px solid color-mix(in srgb, var(--color-blog) 45%, var(--color-border)); border-radius: var(--radius-pill); padding: .42rem .7rem; background: color-mix(in srgb, var(--color-surface) 92%, transparent); color: var(--color-text); font: 700 .68rem/1 var(--font-mono); text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }
  :global(.code-copy-button:hover) { border-color: var(--color-blog); background: var(--color-blue-soft); }
  @media (max-width: 48rem) { .article-header__meta, .article-header__body { grid-column: 1 / -1; } }
  .project-header { display: grid; grid-template-columns: minmax(0, 8fr) auto; align-items: end; gap: var(--space-7); border-top: .5rem solid var(--color-accent); border-bottom: 1px solid var(--color-border-strong); padding: clamp(2rem, 6vw, 5rem) clamp(0rem, 3vw, 2rem); }
  .project-header h1 { max-width: 16ch; font-size: clamp(2.7rem, 6vw, 5.8rem); }
  .project-header .lede { max-width: 52rem; }
  .project-back { border-bottom: 1px solid currentColor; color: var(--color-text); font-weight: 750; text-decoration: none; }
  @media (max-width: 48rem) { .project-header { grid-template-columns: 1fr; align-items: start; } }
  .engineering-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--color-border-strong); }
  .engineering-summary > div { display: grid; align-content: start; gap: .45rem; min-height: 6rem; border-right: 1px solid var(--color-border); padding: var(--space-4); }
  .engineering-summary > div:nth-child(4n) { border-right: 0; }
  .engineering-summary__wide { grid-column: span 2; }
  .engineering-summary dt { color: var(--color-accent-strong); font: 750 .64rem/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .engineering-summary dd { margin: 0; color: var(--color-text); font-size: .88rem; line-height: 1.55; overflow-wrap: anywhere; }
  @media (max-width: 54rem) { .engineering-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); } .engineering-summary > div:nth-child(odd) { border-right: 1px solid var(--color-border); } .engineering-summary > div:nth-child(even) { border-right: 0; } }
  @media (max-width: 32rem) { .engineering-summary { grid-template-columns: 1fr; } .engineering-summary > div, .engineering-summary > div:nth-child(odd) { min-height: 0; border-right: 0; border-bottom: 1px solid var(--color-border); padding-inline: 0; } .engineering-summary > div:last-child { border-bottom: 0; } .engineering-summary__wide { grid-column: auto; } }
  .article-rail { position: sticky; top: var(--space-5); display: grid; gap: var(--space-5); color: var(--color-text-muted); font-size: .78rem; }
  .article-rail > div:first-child { display: grid; gap: .35rem; border-top: 1px solid var(--color-border-strong); padding-top: var(--space-3); }
  .article-rail > div:first-child strong { color: var(--color-text); font-size: .9rem; }
  .article-rail nav { max-height: min(44vh, 25rem); overflow: auto; }
  .article-rail ol { display: grid; gap: .2rem; margin: 0; padding: 0; list-style: none; }
  .article-rail li[data-depth='3'] { padding-left: var(--space-3); }
  .article-rail a { display: block; border-left: 2px solid var(--color-border); padding: .36rem .65rem; color: var(--color-text-muted); line-height: 1.35; text-decoration: none; }
  .article-rail a:hover, .article-rail a[aria-current='location'] { border-left-color: var(--color-accent); color: var(--color-text); }
  .article-rail__empty { color: var(--color-text-muted); }
  .article-rail__progress { display: grid; gap: .45rem; }
  .article-rail__progress > div { display: flex; justify-content: space-between; gap: var(--space-3); font: 650 .68rem/1.4 var(--font-mono); }
  .article-rail progress { width: 100%; height: .35rem; border: 0; border-radius: var(--radius-pill); background: var(--color-surface-strong); color: var(--color-accent); accent-color: var(--color-accent); }
  .article-rail progress::-webkit-progress-bar { border-radius: var(--radius-pill); background: var(--color-surface-strong); }
  .article-rail progress::-webkit-progress-value { border-radius: var(--radius-pill); background: var(--color-accent); }
  .article-rail button { width: fit-content; border: 0; border-bottom: 1px solid currentColor; padding: .25rem 0; background: transparent; color: var(--color-text); font: 700 .72rem/1.4 var(--font-mono); cursor: pointer; }
  @media (max-width: 64rem) { .article-rail { display: none; } }
  @media (prefers-reduced-motion: reduce) { .article-rail { scroll-behavior: auto; } }
</style>
