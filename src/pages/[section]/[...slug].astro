---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isPublic, statusLabels } from '../../lib/content';

export async function getStaticPaths() {
  const [notes, projects] = await Promise.all([
    getCollection('blog', isPublic),
    getCollection('projects', isPublic),
  ]);
  return [...notes, ...projects].map((entry) => ({
    params: { section: entry.collection === 'blog' ? 'notes' : 'projects', slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'blog'> | CollectionEntry<'projects'>; }
const { entry } = Astro.props;
const { data } = entry;
const project = entry.collection === 'projects' ? entry.data : undefined;
const contentType = project ? '项目' : '文章';
const tocLabel = `${contentType}目录`;
const { Content, headings } = await render(entry);
const visibleHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const published = project ? data.created : data.published ?? data.created;

function readingMinutes(body = '') {
  const chineseCharacters = body.match(/[\u3400-\u9fff]/g)?.length ?? 0;
  const latinWords = body.replace(/[\u3400-\u9fff]/g, ' ').match(/\b[\w-]+\b/g)?.length ?? 0;
  return Math.max(1, Math.ceil(chineseCharacters / 350 + latinWords / 220));
}

const compactSummary = (project ? [
  { label: '项目状态', value: statusLabels[data.status] },
  { label: '时间范围', value: project.time_range ?? (data.created.getTime() === data.updated.getTime()
    ? formatDate(data.created)
    : `${formatDate(data.created)} — ${formatDate(data.updated)}`) },
  { label: '作者角色', value: project.role },
  { label: '硬件平台', value: project.hardware },
  { label: '软件环境', value: project.software },
  { label: '技术栈', value: (project.stack.length ? project.stack : data.tags).join(' · ') },
] : [
  { label: '状态', value: statusLabels[data.status] },
  { label: '适用版本', value: data.applicable_version },
  { label: '首次发布', value: formatDate(published) },
  { label: data.verified ? '最后验证' : '最后更新', value: formatDate(data.verified ?? data.updated) },
  { label: '预计阅读', value: `${readingMinutes(entry.body)} 分钟` },
]).filter(({ value }) => value?.trim());

const wideSummary = (project ? [
  { label: '核心结果', value: project.result },
  { label: '验证方式', value: project.validation },
  { label: '当前限制', value: project.limitations },
  { label: '下一步', value: project.next_step },
] : [
  { label: '问题', value: data.problem ?? data.description },
  { label: '环境', value: data.environment ?? data.tags.join(' · ') },
  { label: '结论', value: data.conclusion },
]).filter(({ value }) => value?.trim());

const origin = Astro.site ?? Astro.url.origin;
const person = { '@type': 'Person', name: '万志成', alternateName: 'Wanone' };
const jsonLd = {
  '@context': 'https://schema.org',
  ...(project
    ? { '@type': 'CreativeWork', name: data.title, creator: person, dateCreated: published.toISOString() }
    : { '@type': 'TechArticle', headline: data.title, author: person, datePublished: published.toISOString() }),
  description: data.description,
  url: new URL(`/${Astro.params.section}/${data.slug}/`, origin).href,
  dateModified: data.updated.toISOString(),
  inLanguage: 'zh-CN',
  keywords: data.tags,
  image: data.cover ? new URL(data.cover, origin).href : undefined,
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  contentType={contentType}
  image={data.cover}
  socialType="article"
  published={published}
  updated={data.updated}
  jsonLd={jsonLd}
  sectionLabel={project ? '项目档案' : '工程笔记'}
>
  <article class:list={['detail-page', project ? 'project-detail' : 'article-detail']}>
    <header class="detail-header">
      <div class="detail-header__bar">
        <a class="back-pill" href={project ? '/projects/' : '/notes/'} data-sound="tick">
          ← {project ? '返回项目列表' : '返回笔记列表'}
        </a>
        <div class="detail-header__meta">
          <span>{project ? 'PROJECT · 工程档案' : (data.category ?? '工程笔记')}</span>
          <span>·</span>
          <time datetime={data.updated.toISOString()}>更新于 {formatDate(data.updated)}</time>
        </div>
      </div>

      <div class="detail-header__copy">
        <h1>{data.title}</h1>
        <p class="lede">{data.description}</p>
        <div class="tag-row">
          {data.tags.map((tag) => project
            ? <span class="tag">{tag}</span>
            : <a class="tag" href={`/tags/#${encodeURIComponent(tag)}`}>{tag}</a>)}
        </div>
      </div>

      {(compactSummary.length > 0 || wideSummary.length > 0) && (
        <div class="summary-stack" aria-label={`${contentType}工程摘要`}>
          {compactSummary.length > 0 && (
            <dl class="engineering-summary engineering-summary--compact">
              {compactSummary.map((item) => (
                <div class="summary-cell">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          )}
          {wideSummary.length > 0 && (
            <dl class="engineering-summary engineering-summary--wide">
              {wideSummary.map((item) => (
                <div class="summary-cell">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      )}
    </header>

    <div class="article-layout">
      <div class="article-shell prose">
        {project?.slug === 'obsidian-astro-publishing' && (
          <aside class="publish-notice" aria-label="当前发布方式">
            <strong>当前发布方式</strong>
            <p>下文记录初版流程。现在本地运行 <code>npm run content:publish</code> 同步并构建，推送至 main 后由 GitHub Actions 构建并部署到 GitHub Pages。</p>
          </aside>
        )}
        <Content />
      </div>

      <aside class="article-rail" aria-label={tocLabel} data-article-rail>
        <div class="rail-card">
          <div class="rail-card__head">
            <strong>{tocLabel}</strong>
            <output class="rail-card__percent" data-reading-percent>0%</output>
          </div>
          <progress max="100" value="0" data-reading-progress>0%</progress>
          {visibleHeadings.length > 0 ? (
            <nav aria-label={tocLabel}>
              <ol>
                {visibleHeadings.map((heading) => (
                  <li data-depth={heading.depth}>
                    <a href={`#${heading.slug}`} data-heading-link={heading.slug}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          ) : <p class="article-rail__empty">这篇内容暂时没有分节标题。</p>}
          <button type="button" class="rail-top-btn" data-back-to-top>返回顶部 ↑</button>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<script>
  import { playSound } from '../../lib/sound';

  document.querySelectorAll<HTMLElement>('[data-article-rail]').forEach((rail) => {
    const progress = rail.querySelector<HTMLProgressElement>('[data-reading-progress]');
    const output = rail.querySelector<HTMLOutputElement>('[data-reading-percent]');
    const links = [...rail.querySelectorAll<HTMLAnchorElement>('[data-heading-link]')];
    const topButton = rail.querySelector<HTMLButtonElement>('[data-back-to-top]');
    let frame = 0;

    const updateProgress = () => {
      frame = 0;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const value = scrollable > 0 ? Math.min(100, Math.max(0, Math.round((window.scrollY / scrollable) * 100))) : 100;
      if (progress) progress.value = value;
      if (output) output.value = `${value}%`;
    };
    const requestProgress = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateProgress);
    };
    updateProgress();
    window.addEventListener('scroll', requestProgress, { passive: true });
    window.addEventListener('resize', requestProgress);

    if ('IntersectionObserver' in window && links.length > 0) {
      const headingById = new Map(links.map((link) => [link.dataset.headingLink ?? '', link]));
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        links.forEach((link) => link.removeAttribute('aria-current'));
        headingById.get(visible.target.id)?.setAttribute('aria-current', 'location');
      }, { rootMargin: '-18% 0px -68% 0px' });
      headingById.forEach((_, id) => {
        const heading = document.getElementById(id);
        if (heading) observer.observe(heading);
      });
    }

    topButton?.addEventListener('click', () => {
      playSound('tick');
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    });
  });

  document.querySelectorAll<HTMLElement>('.article-shell pre').forEach((codeBlock, index) => {
    if (codeBlock.dataset.copyReady === 'true') return;
    codeBlock.dataset.copyReady = 'true';
    codeBlock.tabIndex = 0;
    const shell = document.createElement('div');
    shell.className = 'code-copy-shell';
    codeBlock.before(shell);
    shell.append(codeBlock);
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy-button';
    button.textContent = '复制';
    button.setAttribute('aria-label', `复制第 ${index + 1} 个代码块`);
    shell.append(button);
    button.addEventListener('click', async () => {
      const code = codeBlock.querySelector('code')?.textContent ?? codeBlock.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = '已复制';
        playSound('chime');
      } catch {
        button.textContent = '复制失败';
      }
      window.setTimeout(() => { button.textContent = '复制'; }, 1800);
    });
  });
</script>

<style>
  .detail-page {
    display: grid;
    gap: 32px;
  }

  .detail-header {
    display: grid;
    gap: 20px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
  }

  .detail-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .back-pill {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 12.5px;
    font-weight: 550;
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }
  .back-pill:hover {
    background: var(--color-surface);
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .detail-header__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 500 11.5px/1.3 var(--font-mono);
    color: var(--color-text-muted);
  }

  .detail-header__copy {
    display: grid;
    gap: 12px;
  }
  .detail-header__copy h1 {
    font-size: clamp(1.75rem, 3.2vw, 2.45rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.025em;
    max-width: 28ch;
  }

  .summary-stack {
    display: grid;
    gap: 10px;
  }
  .engineering-summary {
    display: grid;
    gap: 10px;
    margin: 0;
  }
  .engineering-summary--compact {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }
  .engineering-summary--wide {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .summary-cell {
    display: grid;
    align-content: start;
    gap: 5px;
    padding: 13px 15px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .summary-cell dt {
    color: var(--color-text-muted);
    font: 600 11px/1.3 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .summary-cell dd {
    margin: 0;
    color: var(--color-text);
    font-size: 13.5px;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  @media (max-width: 44rem) {
    .engineering-summary--wide {
      grid-template-columns: 1fr;
    }
  }

  .publish-notice {
    padding: 14px 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    display: grid;
    gap: 4px;
    font-size: 13.5px;
  }
  .publish-notice strong {
    color: var(--color-text);
    font-size: 12.5px;
    font-family: var(--font-mono);
  }

  /* 右侧目录卡片 */
  .article-rail {
    position: sticky;
    top: calc(var(--topbar-height) + 20px);
  }
  .rail-card {
    display: grid;
    gap: 12px;
    padding: 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: 12.5px;
  }
  .rail-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .rail-card__head strong {
    font-size: 12.5px;
    font-weight: 650;
    color: var(--color-text);
  }
  .rail-card__percent {
    font: 600 11px/1 var(--font-mono);
    color: var(--color-text-muted);
  }
  .rail-card progress {
    width: 100%;
    height: 4px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-border);
    accent-color: var(--color-accent);
  }
  .rail-card progress::-webkit-progress-bar {
    border-radius: var(--radius-pill);
    background: var(--color-border);
  }
  .rail-card progress::-webkit-progress-value {
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }
  .rail-card nav {
    max-height: min(46vh, 24rem);
    overflow-y: auto;
  }
  .rail-card ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rail-card li[data-depth='3'] {
    padding-left: 12px;
  }
  .rail-card a {
    display: block;
    border-left: 2px solid transparent;
    border-radius: 0 6px 6px 0;
    padding: 5px 8px;
    color: var(--color-text-muted);
    line-height: 1.4;
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }
  .rail-card a:hover,
  .rail-card a[aria-current='location'] {
    border-left-color: var(--color-accent);
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: 550;
  }
  .article-rail__empty {
    color: var(--color-text-muted);
  }
  .rail-top-btn {
    width: 100%;
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font: 550 12px/1.2 var(--font-mono);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .rail-top-btn:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  /* 代码复制按钮 */
  :global(.code-copy-shell) {
    position: relative;
    margin-block: 0.75rem;
  }
  :global(.code-copy-shell pre) {
    margin-block: 0;
    padding-top: 2.75rem;
  }
  :global(.code-copy-button) {
    position: absolute;
    z-index: 2;
    top: 8px;
    right: 8px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 4px 10px;
    background: var(--color-bg);
    color: var(--color-text-muted);
    font: 600 11px/1.2 var(--font-mono);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }
  :global(.code-copy-button:hover) {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text);
  }
</style>
