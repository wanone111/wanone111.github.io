---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import PageIntro from '../../components/PageIntro.astro';
import { byNewest, isPublic } from '../../lib/content';

const posts = (await getCollection('blog', isPublic)).sort(byNewest);
const categories = [...new Set(posts.map((post) => post.data.category).filter(Boolean))] as string[];
const categoryKey = (category: string) => {
  if (category.includes('机器人')) return 'robotics';
  if (category.includes('嵌入式')) return 'embedded';
  if (category.includes('FPGA')) return 'fpga';
  if (category.includes('视觉')) return 'vision';
  if (category.includes('编程')) return 'programming';
  if (category.includes('算法') || category.includes('控制')) return 'algorithms';
  if (category.includes('Linux') || category.includes('工程工具') || category.includes('开发')) return 'tooling';
  return encodeURIComponent(category.toLocaleLowerCase('zh-CN'));
};
const categoryOptions = [...new Set(categories.map(categoryKey))].map((key) => {
  const labels = categories.filter((category) => categoryKey(category) === key);
  return {
    key,
    label: labels.join(' / '),
    count: posts.filter((post) => post.data.category && labels.includes(post.data.category)).length,
  };
});
---

<BaseLayout title="笔记" description="开发记录、完整教程、项目复盘和技术思考。" sectionLabel="工程笔记">
  <div class="stack-lg">
    <PageIntro eyebrow={`Notes · ${posts.length}`} title="工程笔记" />
    {posts.length > 0 ? (
      <section class="stack" data-blog-filter>
        <div class="blog-toolbar">
          <div class="filter-list" aria-label="按分类筛选" data-filter-list>
            <button type="button" class="filter-pill" aria-pressed="true" data-category="all">全部 · {posts.length}</button>
            {categoryOptions.map((category) => (
              <button type="button" class="filter-pill" aria-pressed="false" data-category={category.key}>
                {category.label} · {category.count}
              </button>
            ))}
          </div>
          <div class="blog-toolbar__meta">
            <p aria-live="polite"><strong data-visible-count>{posts.length}</strong> 篇可见</p>
            <div class="blog-toolbar__links">
              <a href="/archive/" data-sound="tick">时间归档</a>
              <a href="/tags/" data-sound="tick">技术标签</a>
            </div>
          </div>
        </div>
        <div class="article-grid" aria-live="polite">
          {posts.map((post) => (
            <div class="article-grid__item" data-post-category={post.data.category ? categoryKey(post.data.category) : ''}>
              <ArticleRow post={post} headingLevel="h2" />
            </div>
          ))}
        </div>
      </section>
    ) : <div class="empty-state">暂无公开文章。</div>}
  </div>
</BaseLayout>

<script>
  import { playSound } from '../../lib/sound';

  document.querySelectorAll<HTMLElement>('[data-blog-filter]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-category]')];
    const posts = [...root.querySelectorAll<HTMLElement>('[data-post-category]')];
    const count = root.querySelector<HTMLElement>('[data-visible-count]');
    const available = new Set(buttons.map((button) => button.dataset.category ?? 'all'));

    const applyCategory = (requested: string | null, updateHistory = false) => {
      const selected = requested && available.has(requested) ? requested : 'all';
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.category === selected)));
      let visible = 0;
      posts.forEach((post) => {
        const matches = selected === 'all' || post.dataset.postCategory === selected;
        post.toggleAttribute('hidden', !matches);
        if (matches) visible += 1;
      });
      if (count) count.textContent = String(visible);
      if (updateHistory) {
        const url = new URL(window.location.href);
        selected === 'all' ? url.searchParams.delete('category') : url.searchParams.set('category', selected);
        window.history.pushState({ category: selected }, '', `${url.pathname}${url.search}${url.hash}`);
      }
    };

    buttons.forEach((button) => button.addEventListener('click', () => {
      applyCategory(button.dataset.category ?? 'all', true);
      playSound('tick');
    }));
    window.addEventListener('popstate', () => applyCategory(new URL(window.location.href).searchParams.get('category')));
    applyCategory(new URL(window.location.href).searchParams.get('category'));
  });
</script>

<style>
  .blog-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .filter-pill {
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .filter-pill:hover {
    color: var(--color-text);
    background: var(--color-surface-hover);
  }
  .filter-pill[aria-pressed='true'] {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .blog-toolbar__meta {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--color-text-muted);
    font: 500 12px/1.4 var(--font-mono);
  }
  .blog-toolbar__meta strong {
    color: var(--color-text);
  }
  .blog-toolbar__links {
    display: flex;
    gap: 8px;
  }
  .blog-toolbar__links a {
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 12px;
    font-weight: 550;
    text-decoration: none;
    transition: background var(--transition-fast);
  }
  .blog-toolbar__links a:hover {
    background: var(--color-surface);
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .article-grid__item {
    display: grid;
  }
  @media (max-width: 60rem) {
    .article-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
