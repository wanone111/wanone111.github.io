---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout canonicalPath="/404.html" title="页面未找到" description="请求的页面不存在。" sectionLabel="404">
  <section class="not-found">
    <div class="not-found__copy stack">
      <p class="eyebrow">404</p>
      <h1>这页没找到。</h1>
      <p class="lede">可以拖动右侧卡片，或者直接返回首页。</p>
      <div class="button-row">
        <a class="button" href="/" data-sound="pop">返回画廊首页</a>
        <a class="button secondary" href="/notes/" data-sound="tick">查看工程笔记</a>
        <a class="button secondary" href="/knowledge/" data-sound="tick">进入知识库</a>
      </div>
    </div>

    <div class="knowledge-scatter" data-knowledge-scatter aria-label="可拖动的知识卡片">
      <a class="scatter-card scatter-card--dark" href="/knowledge/embedded/" data-scatter-card style="--x: 7%; --y: 12%; --r: -4deg;">
        <small>Path 01</small>
        <strong>嵌入式与通信</strong>
        <span>接口 · 时序 · 控制</span>
      </a>
      <a class="scatter-card" href="/knowledge/robotics/" data-scatter-card style="--x: 50%; --y: 8%; --r: 3deg;">
        <small>Path 02</small>
        <strong>机器人系统</strong>
        <span>ROS 2 · PX4 · 仿真</span>
      </a>
      <a class="scatter-card scatter-card--soft" href="/knowledge/fpga-edge-ai/" data-scatter-card style="--x: 16%; --y: 52%; --r: 2.5deg;">
        <small>Path 03</small>
        <strong>FPGA 与边缘 AI</strong>
        <span>并行 · HLS · PYNQ</span>
      </a>
      <a class="scatter-card" href="/knowledge/linux-tools/" data-scatter-card style="--x: 56%; --y: 50%; --r: -3deg;">
        <small>Path 04</small>
        <strong>Linux 与工程工具</strong>
        <span>系统 · 工具 · 自动化</span>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import { playSound } from '../lib/sound';

  document.querySelectorAll<HTMLElement>('[data-scatter-card]').forEach((card) => {
    let startX = 0;
    let startY = 0;
    let originX = 0;
    let originY = 0;
    let moved = false;
    const readPosition = () => ({
      x: Number.parseFloat(card.dataset.dragX ?? '0'),
      y: Number.parseFloat(card.dataset.dragY ?? '0'),
    });
    card.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      const position = readPosition();
      startX = event.clientX;
      startY = event.clientY;
      originX = position.x;
      originY = position.y;
      moved = false;
      card.setPointerCapture(event.pointerId);
      card.dataset.dragging = 'true';
      playSound('tick');
    });
    card.addEventListener('pointermove', (event) => {
      if (!card.hasPointerCapture(event.pointerId)) return;
      const x = originX + event.clientX - startX;
      const y = originY + event.clientY - startY;
      moved ||= Math.abs(x - originX) + Math.abs(y - originY) > 5;
      card.dataset.dragX = String(x);
      card.dataset.dragY = String(y);
      card.style.setProperty('--drag-x', `${x}px`);
      card.style.setProperty('--drag-y', `${y}px`);
    });
    const endDrag = (event: PointerEvent) => {
      if (card.hasPointerCapture(event.pointerId)) card.releasePointerCapture(event.pointerId);
      delete card.dataset.dragging;
      if (moved) playSound('thud');
    };
    card.addEventListener('pointerup', endDrag);
    card.addEventListener('pointercancel', endDrag);
    card.addEventListener('click', (event) => {
      if (moved) event.preventDefault();
    });
  });
</script>

<style>
  .not-found {
    display: grid;
    grid-template-columns: minmax(18rem, 0.9fr) minmax(22rem, 1.1fr);
    align-items: center;
    gap: 32px;
    padding-block: 16px 32px;
  }
  .not-found__copy h1 {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    max-width: 16ch;
  }
  .knowledge-scatter {
    position: relative;
    min-height: 28rem;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    overflow: hidden;
  }
  .knowledge-scatter::before {
    content: '拖动整理 · 点击进入';
    position: absolute;
    right: 16px;
    bottom: 14px;
    color: var(--color-text-subtle);
    font: 500 11px/1 var(--font-mono);
  }
  .scatter-card {
    --drag-x: 0px;
    --drag-y: 0px;
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: grid;
    width: min(14rem, 42%);
    min-height: 9rem;
    align-content: center;
    gap: 6px;
    transform: translate(var(--drag-x), var(--drag-y)) rotate(var(--r));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 18px;
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    touch-action: none;
    user-select: none;
    cursor: grab;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .scatter-card:hover {
    border-color: var(--color-border-strong);
  }
  .scatter-card--soft {
    background: var(--color-bg);
  }
  .scatter-card--dark {
    background: var(--color-card-dark);
    border-color: var(--color-card-dark-border);
    color: var(--color-card-dark-text);
  }
  .scatter-card--dark small,
  .scatter-card--dark span {
    color: var(--color-card-dark-muted);
  }
  .scatter-card[data-dragging='true'] {
    z-index: 4;
    box-shadow: var(--shadow-float);
    cursor: grabbing;
  }
  .scatter-card small {
    color: var(--color-text-muted);
    font: 500 11px/1 var(--font-mono);
  }
  .scatter-card strong {
    font-size: 16px;
    font-weight: 700;
  }
  .scatter-card span {
    color: var(--color-text-muted);
    font-size: 12.5px;
  }

  @media (max-width: 64rem) {
    .not-found {
      grid-template-columns: 1fr;
    }
    .knowledge-scatter {
      min-height: 24rem;
    }
  }
  @media (max-width: 36rem) {
    .knowledge-scatter {
      display: grid;
      min-height: auto;
      gap: 12px;
      padding: 14px;
    }
    .knowledge-scatter::before {
      display: none;
    }
    .scatter-card {
      position: relative;
      left: auto;
      top: auto;
      width: 100%;
      min-height: auto;
      transform: translate(var(--drag-x), var(--drag-y));
    }
  }
</style>
