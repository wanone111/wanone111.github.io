---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublic } from '../lib/content';

export async function getStaticPaths() {
  const pages = await getCollection('pages', isPublic);
  return [
    { slug: 'about', title: '关于', description: '万志成的学习背景、工程方向、项目实践与工作方法。' },
    { slug: 'resume', title: '简历', description: '万志成的教育背景、专业技能与项目经历。' },
    { slug: 'links', title: '友链', description: '经确认后公开的朋友站点与独立网站链接。' },
  ].map(({ slug, title, description }) => ({
    params: { page: slug },
    props: { page: pages.find((entry) => entry.data.slug === slug), title, description },
  }));
}

interface Props { page?: CollectionEntry<'pages'>; title: string; description: string; }
const { page } = Astro.props;
const { title, description } = page?.data ?? Astro.props;
const slug = Astro.params.page!;
const eyebrow = slug.charAt(0).toUpperCase() + slug.slice(1);
const Content = page && (await render(page)).Content;
---

<BaseLayout title={title} description={description}>
  <div class="stack-lg">
    <PageIntro eyebrow={eyebrow} title={title} description={description} />
    {Content ? (
      <section class="article-shell prose"><Content /></section>
    ) : slug === 'about' ? (
      <section class="article-shell stack">
        <h2>关于我</h2>
        <p class="lede">我是万志成，主要实践方向包括嵌入式软件、机器人系统、FPGA 视频链路和边缘 AI 部署。</p>
        <h2>工程方法</h2>
        <p class="lede">我重视可复现测试、日志记录和文档沉淀，并通过构建状态、通信记录和对照实验逐步定位问题。</p>
      </section>
    ) : <div class="empty-state">暂无公开{title}。</div>}
  </div>
</BaseLayout>
