---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { byNewest, formatDate, isPublic } from '../../lib/content';

const posts = (await getCollection('blog', isPublic)).sort(byNewest);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))]
  .map((tag) => ({ tag, posts: posts.filter((post) => post.data.tags.includes(tag)) }))
  .sort((a, b) => b.posts.length - a.posts.length || a.tag.localeCompare(b.tag, 'zh-CN'));
---

<BaseLayout title="标签" description="按技术标签浏览笔记。" sectionLabel="技术标签">
  <div class="stack-lg">
    <PageIntro eyebrow={`Tags · ${tags.length}`} title="技术标签" />
    {tags.length > 0 ? (
      <div class="tag-browser">
        <nav class="tag-index" aria-label="标签索引">
          <p class="eyebrow">All Tags</p>
          <div class="tag-index__list">
            {tags.map(({ tag, posts }) => (
              <a class="tag-pill" href={`#${encodeURIComponent(tag)}`} data-sound="tick">
                <span>{tag}</span>
                <small>{posts.length}</small>
              </a>
            ))}
          </div>
        </nav>

        <div class="tag-groups">
          {tags.map(({ tag, posts }) => (
            <section class="tag-group" id={tag} aria-labelledby={`${tag}-title`} data-tag-section>
              <header class="tag-group__head">
                <div>
                  <p class="eyebrow">TAG</p>
                  <h2 id={`${tag}-title`}>{tag}</h2>
                </div>
                <span class="tag">{posts.length} 篇文章</span>
              </header>
              <ol class="tag-group__list">
                {posts.map((post) => (
                  <li>
                    <a class="tag-group__row" href={`/notes/${post.data.slug}/`} data-sound="pop">
                      <span class="tag-group__type">{post.data.category ?? '工程笔记'}</span>
                      <strong>{post.data.title}</strong>
                      <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </div>
    ) : <div class="empty-state">暂无公开标签。</div>}
  </div>
</BaseLayout>

<style>
  .tag-browser {
    display: grid;
    grid-template-columns: minmax(13rem, 16rem) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .tag-index {
    position: sticky;
    top: calc(var(--topbar-height) + 20px);
    display: grid;
    gap: 10px;
    max-height: calc(100vh - var(--topbar-height) - 40px);
    overflow-y: auto;
    padding: 16px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .tag-index__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font: 500 12px/1.3 var(--font-mono);
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }
  .tag-pill small {
    color: var(--color-text-subtle);
    font-size: 11px;
  }
  .tag-pill:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .tag-pill:hover small {
    color: var(--color-accent-ink);
    opacity: 0.8;
  }

  .tag-groups {
    display: grid;
    gap: 16px;
  }
  .tag-group {
    scroll-margin-top: calc(var(--topbar-height) + 20px);
    padding: 20px 22px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .tag-group__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-border);
  }
  .tag-group__head h2 {
    margin-top: 2px;
    font-size: 1.25rem;
  }
  .tag-group__list {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }
  .tag-group__row {
    display: grid;
    grid-template-columns: minmax(6rem, 8rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 10px;
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    transition: background var(--transition-fast);
  }
  .tag-group__row:hover {
    background: var(--color-surface);
  }
  .tag-group__row strong {
    font-size: 14px;
    font-weight: 600;
  }
  .tag-group__type,
  .tag-group__row time {
    color: var(--color-text-muted);
    font: 500 11.5px/1.3 var(--font-mono);
  }

  @media (max-width: 56rem) {
    .tag-browser {
      grid-template-columns: 1fr;
    }
    .tag-index {
      position: static;
      max-height: none;
    }
  }
  @media (max-width: 36rem) {
    .tag-group__row {
      grid-template-columns: 1fr auto;
      gap: 4px 10px;
    }
    .tag-group__type {
      grid-column: 1 / -1;
    }
  }
</style>
