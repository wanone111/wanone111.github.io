---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<header class="page-intro">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {description && <p class="lede">{description}</p>}
</header>

<style>
  .page-intro {
    display: grid;
    gap: 10px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
  }
  .page-intro h1 {
    font-size: clamp(1.75rem, 3.2vw, 2.35rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }
  .page-intro .lede {
    max-width: 44rem;
    font-size: 14.5px;
    line-height: 1.65;
  }
</style>
