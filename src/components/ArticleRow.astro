---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, category = '工程笔记', slug, updated, tags } = post.data;
const href = `/notes/${slug}/`;

const domainClass = (cat = '') => {
  const c = cat.toLowerCase();
  if (c.includes('fpga') || c.includes('hls') || c.includes('verilog')) return 'd-fpga';
  if (c.includes('robot') || c.includes('机器人') || c.includes('算法')) return 'd-robot';
  if (c.includes('embed') || c.includes('嵌入式')) return 'd-embed';
  return 'd-tool';
};
---

<article class:list={['article-card', domainClass(category)]}>
  <a class="article-card__link" href={href} data-sound="pop">
    <div class="article-card__top">
      <span class="article-card__eyebrow"><span class="dot"></span>笔记 · {category}</span>
      <time class="article-card__date" datetime={updated.toISOString()}>{formatDate(updated)}</time>
    </div>
    <Heading class="article-card__title">{title}</Heading>
    <p class="article-card__desc">{description}</p>
    <div class="article-card__footer">
      <div class="tag-row">
        {tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <span class="circle-arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</article>

<style>
  .d-robot { --d: var(--color-robot); }
  .d-fpga { --d: var(--color-fpga); }
  .d-embed { --d: var(--color-embed); }
  .d-tool { --d: var(--color-tool); }

  .article-card {
    --d: var(--color-tool);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--d) 2.5%, var(--color-surface));
    box-shadow: var(--shadow-soft);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .article-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--d) 40%, var(--color-border));
    box-shadow: var(--shadow-hover);
  }
  .article-card__link {
    display: grid;
    gap: 8px;
    padding: 20px;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }
  .article-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .article-card__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: 550 11.5px/1.3 var(--font-mono);
    color: var(--color-text-muted);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--d);
  }
  .article-card__date {
    font: 500 11.5px/1.3 var(--font-mono);
    color: var(--color-text-subtle);
  }
  .article-card__title {
    font-size: 16.5px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }
  .article-card__desc {
    font-size: 13.5px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .article-card__footer {
    margin-top: auto;
    padding-top: 8px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
  }
  .article-card:hover .circle-arrow {
    transform: translate(2px, -2px);
    background: var(--d);
    color: #ffffff;
  }
</style>
