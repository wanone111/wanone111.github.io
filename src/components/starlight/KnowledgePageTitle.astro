---
import { getCollection } from 'astro:content';
import { knowledgePaths } from '../../data/knowledge';
import { byNewest, formatDate, isPublic } from '../../lib/content';

const title = Astro.locals.starlightRoute.entry.data.title;
const pathname = Astro.url.pathname.replace(/\/$/, '');
const root = pathname === '/knowledge';
const path = knowledgePaths.find(({ href }) => href === `${pathname}/`);
const posts = root || path ? await getCollection('blog', isPublic) : [];
const relatedPosts = path
  ? posts.filter(({ data }) => path.matches(data.slug)).sort(byNewest).slice(0, 4)
  : [];
---

<h1 id="_top">{title}</h1>
{root && (
  <nav id="技术方向" aria-labelledby="knowledge-garden-title">
    <h2 id="knowledge-garden-title">知识路径</h2>
    <ul>
      {knowledgePaths.map(({ href, title, description, matches }) => (
        <li>
          <a href={href}>{title}</a>
          <span>{description} · {posts.filter(({ data }) => matches(data.slug)).length} 篇相关笔记</span>
        </li>
      ))}
    </ul>
  </nav>
)}
{path && relatedPosts.length > 0 && (
  <nav aria-label={`${path.title}相关文章`}>
    <h2>沿此路径继续</h2>
    <ul>
      {relatedPosts.map(({ data }) => (
        <li>
          <a href={`/notes/${data.slug}/`}>{data.title}</a>
          <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  h1 { margin-top: 0; }
  nav { margin-block: var(--space-6); }
  nav h2 { font-size: 1.35rem; }
  ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 0 var(--space-5); margin: 0; padding: 0; list-style: none; }
  li { display: grid; gap: var(--space-1); border-bottom: 1px solid var(--color-border); padding-block: var(--space-3); }
  a { font-weight: 700; }
  time, span { color: var(--color-text-muted); font-size: .82rem; }
</style>
