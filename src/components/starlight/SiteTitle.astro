<a href="/knowledge/" class="kb-brand" aria-label="Wanone Knowledge 首页">
  <span class="kb-brand__mark" aria-hidden="true">
    <svg viewBox="0 0 32 32" fill="none">
      <rect width="32" height="32" rx="8" fill="var(--color-accent, #111111)" />
      <path d="M7.5 10.5L11.5 21.5L16 12.5L20.5 21.5L24.5 10.5" stroke="var(--color-accent-ink, #FFFFFF)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
  <span class="kb-brand__text">
    <strong>Wanone</strong>
    <small>Knowledge</small>
  </span>
</a>

<style>
  .kb-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-text);
    line-height: 1.2;
  }
  .kb-brand__mark {
    width: 30px;
    height: 30px;
    display: inline-flex;
    flex-shrink: 0;
  }
  .kb-brand__mark svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .kb-brand__text {
    display: flex;
    flex-direction: column;
  }
  .kb-brand__text strong {
    font-size: 14px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .kb-brand__text small {
    font-size: 10.5px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }
</style>
