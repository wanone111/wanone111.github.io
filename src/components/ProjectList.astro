---
import type { CollectionEntry } from 'astro:content';
import { formatDate, statusLabels } from '../lib/content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
const categoryLabels: Record<string, string> = {
  publishing: '内容工程',
  embedded: '嵌入式系统',
  robotics: '机器人系统',
  fpga: 'FPGA 与边缘 AI',
  system: '工程系统',
};

// 仅绑定与项目硬件完全对应的真实照片，不对应的一律不配图
const fallbackCovers: Record<string, string> = {
  'hexapod-robot-cooperative-mapping': '/images/showcase/cluster-trio.jpg',
  'indoor-autonomous-drone': '/images/showcase/drone-front.jpg',
};

const domainClass = (cat = '', slug = '') => {
  const s = `${cat} ${slug}`.toLowerCase();
  if (s.includes('fpga') || s.includes('video')) return 'd-fpga';
  if (s.includes('drone') || s.includes('embed')) return 'd-embed';
  if (s.includes('robot') || s.includes('hexapod')) return 'd-robot';
  return 'd-tool';
};
---

{projects.length ? (
  <div class="project-list">
    {projects.map(({ data }, index) => {
      const { title, description, category = 'system', updated, tags, stack, slug, cover, status, role, result, validation } = data;
      const href = `/projects/${slug}/`;
      const categoryLabel = categoryLabels[category.toLowerCase()] ?? category;
      const displayTags = (stack.length ? stack : tags).slice(0, 6);
      const imageSrc = cover ?? fallbackCovers[slug];
      return (
        <article class:list={['project-card', domainClass(category, slug)]}>
          <div class="project-card__top">
            <div class="project-card__meta">
              <span class="project-card__num">{String(index + 1).padStart(2, '0')}</span>
              <span class="dot" aria-hidden="true"></span>
              <span class="project-card__eyebrow">{categoryLabel} · {statusLabels[status]}</span>
            </div>
            <time class="project-card__date" datetime={updated.toISOString()}>{formatDate(updated)}</time>
          </div>

          <div class:list={['project-card__grid', !imageSrc && 'project-card__grid--no-img']}>
            {imageSrc && (
              <a class="project-card__media" href={href} tabindex="-1" aria-hidden="true">
                <img src={imageSrc} alt={`${title} 的项目实物或验证素材`} loading={index === 0 ? 'eager' : 'lazy'} />
              </a>
            )}

            <div class="project-card__main">
              <h2><a href={href} data-sound="pop">{title}</a></h2>
              <p class="project-card__desc">{description}</p>
              {role && (
                <p class="project-card__role">
                  <span>本人职责</span>
                  {role}
                </p>
              )}
              {(result || validation) && (
                <dl class="project-card__evidence" aria-label={`${title} 的结果与验证`}>
                  {result && (
                    <div class="evidence-box">
                      <dt>核心结果</dt>
                      <dd>{result}</dd>
                    </div>
                  )}
                  {validation && (
                    <div class="evidence-box">
                      <dt>验证方式</dt>
                      <dd>{validation}</dd>
                    </div>
                  )}
                </dl>
              )}
            </div>
          </div>

          <div class="project-card__footer">
            <div class="tag-row">
              {displayTags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <a class="project-card__cta" href={href} data-sound="pop">
              <span>打开工程档案</span>
              <span class="circle-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      );
    })}
  </div>
) : <div class="empty-state">暂无公开项目。</div>}

<style>
  .d-robot { --d: var(--color-robot); }
  .d-fpga { --d: var(--color-fpga); }
  .d-embed { --d: var(--color-embed); }
  .d-tool { --d: var(--color-tool); }

  .project-list {
    display: grid;
    gap: 20px;
  }

  .project-card {
    --d: var(--color-accent-strong);
    display: grid;
    gap: 18px;
    padding: 24px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--d) 2.5%, var(--color-surface));
    box-shadow: var(--shadow-soft);
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }
  .project-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--d) 40%, var(--color-border));
    box-shadow: var(--shadow-hover);
  }

  .project-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .project-card__meta {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--d);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--d) 18%, transparent);
  }
  .project-card__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 24px;
    padding-inline: 7px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--d) 12%, var(--color-surface));
    color: var(--d);
    font: 700 11px/1 var(--font-mono);
  }
  .project-card__eyebrow,
  .project-card__date {
    font: 550 11.5px/1.3 var(--font-mono);
    color: var(--color-text-muted);
  }

  .project-card__grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.95fr) minmax(0, 1.35fr);
    gap: 22px;
    align-items: start;
  }
  .project-card__grid--no-img {
    grid-template-columns: 1fr;
  }
  .project-card__media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    aspect-ratio: 16 / 10;
    background: var(--color-surface-soft);
  }
  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project-card:hover .project-card__media img {
    transform: scale(1.03);
  }

  .project-card__main {
    display: grid;
    gap: 10px;
  }
  .project-card__main h2 {
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    font-weight: 720;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .project-card__main h2 a {
    text-decoration: none;
  }
  .project-card__main h2 a:hover {
    color: var(--d);
  }
  .project-card__desc {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.65;
  }
  .project-card__role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 10px;
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.55;
  }
  .project-card__role span {
    font: 600 11px/1 var(--font-mono);
    color: var(--d);
    text-transform: uppercase;
  }

  .project-card__evidence {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 4px 0 0;
  }
  .evidence-box {
    display: grid;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-soft);
  }
  .evidence-box dt {
    font: 600 11px/1.3 var(--font-mono);
    color: var(--color-text-muted);
  }
  .evidence-box dd {
    margin: 0;
    font-size: 12.5px;
    color: var(--color-text-secondary);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .project-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
  }
  .project-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }
  .project-card:hover .circle-arrow {
    transform: translate(2px, -2px);
    background: var(--d);
    color: #ffffff;
  }

  @media (max-width: 58rem) {
    .project-card__grid {
      grid-template-columns: 1fr;
    }
    .project-card__evidence {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 36rem) {
    .project-card {
      padding: 18px;
    }
  }
</style>
