---
// src/components/LidarSandbox.astro
// 交互式 BX72 麦轮机器人 + 180° 激光雷达建图实验台
---

<div class="lidar-box" data-lidar-sandbox>
  <div class="lidar-box__bar">
    <div class="lidar-box__title">
      <span class="lidar-dot"></span>
      <span class="mono">BX72 LIDAR</span>
    </div>
    <div class="lidar-box__controls">
      <button type="button" class="mini-btn" data-lidar-shuffle data-sound="tick">换障碍</button>
      <button type="button" class="mini-btn" data-lidar-clear data-sound="tick">清地图</button>
    </div>
  </div>

  <div class="lidar-box__stage">
    <canvas data-lidar-canvas aria-label="交互式激光雷达与麦轮小车导航沙盒"></canvas>
    <div class="lidar-hud mono" data-lidar-hud>
      <span>180°</span>
      <span data-lidar-hits>PTS 0</span>
      <span data-lidar-state>CRUISE</span>
    </div>
  </div>

  <div class="lidar-box__foot">
    <span>点击画布放置航点</span>
  </div>
</div>

<script>
  import { playSound } from '../lib/sound';

  document.querySelectorAll<HTMLElement>('[data-lidar-sandbox]').forEach((root) => {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const canvas = root.querySelector<HTMLCanvasElement>('[data-lidar-canvas]');
    const hitsEl = root.querySelector<HTMLElement>('[data-lidar-hits]');
    const stateEl = root.querySelector<HTMLElement>('[data-lidar-state]');
    const shuffleBtn = root.querySelector<HTMLButtonElement>('[data-lidar-shuffle]');
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-lidar-clear]');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let w = 1, h = 1, dpr = 1;
    let colors = {
      bg: '#ffffff',
      grid: 'rgba(54,48,36,0.06)',
      obsFill: '#f1eee6',
      obsStroke: '#d5cfc1',
      robot: '#0d9488',
      accent: '#ea580c',
      fpga: '#7c3aed',
      text: '#181715',
      muted: '#6c675e',
    };

    const readTheme = () => {
      const s = getComputedStyle(document.documentElement);
      const isDark = document.documentElement.dataset.theme === 'dark';
      colors = {
        bg: s.getPropertyValue('--color-surface').trim() || (isDark ? '#131822' : '#ffffff'),
        grid: isDark ? 'rgba(148,163,184,0.09)' : 'rgba(54,48,36,0.065)',
        obsFill: isDark ? '#1e2736' : '#f1eee6',
        obsStroke: isDark ? '#334155' : '#d5cfc1',
        robot: s.getPropertyValue('--color-robot').trim() || '#0d9488',
        accent: s.getPropertyValue('--color-embed').trim() || '#ea580c',
        fpga: s.getPropertyValue('--color-fpga').trim() || '#7c3aed',
        text: s.getPropertyValue('--color-text').trim() || '#181715',
        muted: s.getPropertyValue('--color-text-muted').trim() || '#6c675e',
      };
    };

    type Rect = { x: number; y: number; w: number; h: number };
    const layouts: Rect[][] = [
      [
        { x: 0.24, y: 0.16, w: 0.13, h: 0.22 },
        { x: 0.62, y: 0.18, w: 0.18, h: 0.13 },
        { x: 0.56, y: 0.58, w: 0.14, h: 0.24 },
        { x: 0.18, y: 0.68, w: 0.18, h: 0.12 },
      ],
      [
        { x: 0.32, y: 0.24, w: 0.09, h: 0.44 },
        { x: 0.64, y: 0.28, w: 0.16, h: 0.18 },
        { x: 0.68, y: 0.66, w: 0.12, h: 0.16 },
      ],
      [
        { x: 0.20, y: 0.22, w: 0.18, h: 0.12 },
        { x: 0.54, y: 0.14, w: 0.11, h: 0.28 },
        { x: 0.34, y: 0.62, w: 0.20, h: 0.13 },
        { x: 0.74, y: 0.54, w: 0.12, h: 0.24 },
      ],
    ];
    let layoutIdx = 0;

    const robot = { x: 0.14, y: 0.5, angle: 0, speed: 0 };
    const defaultWaypoints = [
      { x: 0.48, y: 0.42 },
      { x: 0.82, y: 0.36 },
      { x: 0.80, y: 0.76 },
      { x: 0.45, y: 0.80 },
      { x: 0.14, y: 0.48 },
    ];
    let autoIdx = 0;
    let target = { ...defaultWaypoints[0], manual: false };

    const trail: { x: number; y: number }[] = [];
    const hitPoints: { x: number; y: number; age: number }[] = [];
    const MAX_HITS = 260;

    const getObstaclesPx = (): Rect[] =>
      layouts[layoutIdx].map((o) => ({ x: o.x * w, y: o.y * h, w: o.w * w, h: o.h * h }));

    const rayRectDist = (ox: number, oy: number, dx: number, dy: number, r: Rect, maxD: number) => {
      let tmin = 0, tmax = maxD;
      if (Math.abs(dx) < 1e-6) {
        if (ox < r.x || ox > r.x + r.w) return null;
      } else {
        const tx1 = (r.x - ox) / dx;
        const tx2 = (r.x + r.w - ox) / dx;
        tmin = Math.max(tmin, Math.min(tx1, tx2));
        tmax = Math.min(tmax, Math.max(tx1, tx2));
      }
      if (Math.abs(dy) < 1e-6) {
        if (oy < r.y || oy > r.y + r.h) return null;
      } else {
        const ty1 = (r.y - oy) / dy;
        const ty2 = (r.y + r.h - oy) / dy;
        tmin = Math.max(tmin, Math.min(ty1, ty2));
        tmax = Math.min(tmax, Math.max(ty1, ty2));
      }
      if (tmax >= tmin && tmin > 0 && tmin <= maxD) return tmin;
      return null;
    };

    const rayWallDist = (ox: number, oy: number, dx: number, dy: number, maxD: number) => {
      let best = maxD;
      if (dx < -1e-6) best = Math.min(best, (8 - ox) / dx);
      if (dx > 1e-6) best = Math.min(best, (w - 8 - ox) / dx);
      if (dy < -1e-6) best = Math.min(best, (8 - oy) / dy);
      if (dy > 1e-6) best = Math.min(best, (h - 8 - oy) / dy);
      return Math.max(0, best);
    };

    const fit = () => {
      const rect = canvas.getBoundingClientRect();
      w = Math.max(1, rect.width);
      h = Math.max(1, rect.height);
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const pointInObstacles = (px: number, py: number, pad: number, obs: Rect[]) =>
      obs.some((o) => px > o.x - pad && px < o.x + o.w + pad && py > o.y - pad && py < o.y + o.h + pad);

    canvas.addEventListener('pointerdown', (e) => {
      const rect = canvas.getBoundingClientRect();
      const nx = Math.min(0.94, Math.max(0.06, (e.clientX - rect.left) / w));
      const ny = Math.min(0.92, Math.max(0.08, (e.clientY - rect.top) / h));
      target = { x: nx, y: ny, manual: true };
      playSound('pop');
    });

    shuffleBtn?.addEventListener('click', () => {
      layoutIdx = (layoutIdx + 1) % layouts.length;
      hitPoints.length = 0;
      trail.length = 0;
    });

    clearBtn?.addEventListener('click', () => {
      hitPoints.length = 0;
      trail.length = 0;
    });

    let frameTick = 0;
    const step = () => {
      frameTick++;
      const obs = getObstaclesPx();
      const rx = robot.x * w;
      const ry = robot.y * h;
      const tx = target.x * w;
      const ty = target.y * h;

      // 朝向目标 + 简单障碍排斥势场
      let vx = tx - rx;
      let vy = ty - ry;
      const dist = Math.hypot(vx, vy);

      if (dist < 14) {
        if (!target.manual) {
          autoIdx = (autoIdx + 1) % defaultWaypoints.length;
          target = { ...defaultWaypoints[autoIdx], manual: false };
        }
        if (stateEl) stateEl.textContent = target.manual ? 'ARRIVED' : 'CRUISE';
      } else {
        vx /= dist;
        vy /= dist;
        // 障碍物排斥力
        obs.forEach((o) => {
          const cx = Math.max(o.x, Math.min(rx, o.x + o.w));
          const cy = Math.max(o.y, Math.min(ry, o.y + o.h));
          const ox = rx - cx;
          const oy = ry - cy;
          const od = Math.hypot(ox, oy);
          if (od < 42 && od > 0.1) {
            const push = ((42 - od) / 42) * 1.65;
            vx += (ox / od) * push;
            vy += (oy / od) * push;
          }
        });

        const desired = Math.atan2(vy, vx);
        let diff = desired - robot.angle;
        while (diff > Math.PI) diff -= Math.PI * 2;
        while (diff < -Math.PI) diff += Math.PI * 2;
        robot.angle += diff * 0.11;

        const spd = Math.min(1.65, dist * 0.045);
        const nx = rx + Math.cos(robot.angle) * spd;
        const ny = ry + Math.sin(robot.angle) * spd;
        if (!pointInObstacles(nx, ny, 14, obs) && nx > 16 && nx < w - 16 && ny > 16 && ny < h - 16) {
          robot.x = nx / w;
          robot.y = ny / h;
        }
        if (frameTick % 4 === 0) {
          trail.push({ x: robot.x, y: robot.y });
          if (trail.length > 90) trail.shift();
        }
        if (stateEl) stateEl.textContent = target.manual ? 'NAVIGATING' : 'PATROL';
      }

      // 绘制背景与实验网格
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = colors.bg;
      ctx.fillRect(0, 0, w, h);

      ctx.strokeStyle = colors.grid;
      ctx.lineWidth = 1;
      for (let gx = 20; gx < w; gx += 20) {
        ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, h); ctx.stroke();
      }
      for (let gy = 20; gy < h; gy += 20) {
        ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(w, gy); ctx.stroke();
      }

      // 绘制障碍物
      obs.forEach((o) => {
        ctx.fillStyle = colors.obsFill;
        ctx.strokeStyle = colors.obsStroke;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.roundRect(o.x, o.y, o.w, o.h, 8);
        ctx.fill();
        ctx.stroke();
      });

      // 180° 前向激光雷达扫描（33 条射线）
      const rays = 33;
      const maxRange = Math.min(w, h) * 0.42;
      const nrx = robot.x * w;
      const nry = robot.y * h;

      // 扇形扫描面
      ctx.beginPath();
      ctx.moveTo(nrx, nry);
      for (let i = 0; i < rays; i++) {
        const a = robot.angle - Math.PI / 2 + (i / (rays - 1)) * Math.PI;
        const dx = Math.cos(a);
        const dy = Math.sin(a);
        let best = rayWallDist(nrx, nry, dx, dy, maxRange);
        let hitObs = false;
        obs.forEach((o) => {
          const d = rayRectDist(nrx, nry, dx, dy, o, best);
          if (d !== null && d < best) {
            best = d;
            hitObs = true;
          }
        });
        const hx = nrx + dx * best;
        const hy = nry + dy * best;
        ctx.lineTo(hx, hy);

        if (hitObs && frameTick % 3 === 0 && i % 2 === 0) {
          hitPoints.push({ x: hx / w, y: hy / h, age: 1 });
          if (hitPoints.length > MAX_HITS) hitPoints.shift();
        }
      }
      ctx.closePath();
      ctx.fillStyle = colors.robot + '16';
      ctx.fill();

      // 稀疏射线线条
      ctx.strokeStyle = colors.robot + '38';
      ctx.lineWidth = 1;
      for (let i = 0; i < rays; i += 4) {
        const a = robot.angle - Math.PI / 2 + (i / (rays - 1)) * Math.PI;
        const dx = Math.cos(a);
        const dy = Math.sin(a);
        let best = rayWallDist(nrx, nry, dx, dy, maxRange);
        obs.forEach((o) => {
          const d = rayRectDist(nrx, nry, dx, dy, o, best);
          if (d !== null && d < best) best = d;
        });
        ctx.beginPath();
        ctx.moveTo(nrx, nry);
        ctx.lineTo(nrx + dx * best, nry + dy * best);
        ctx.stroke();
      }

      // 历史命中点云（缓慢淡出）
      hitPoints.forEach((p) => {
        p.age = Math.max(0.28, p.age - 0.002);
        ctx.fillStyle = colors.robot;
        ctx.globalAlpha = p.age * 0.85;
        ctx.fillRect(p.x * w - 1.5, p.y * h - 1.5, 3, 3);
      });
      ctx.globalAlpha = 1;
      if (hitsEl && frameTick % 10 === 0) hitsEl.textContent = `PTS ${hitPoints.length}`;

      // 轨迹线
      if (trail.length > 1) {
        ctx.strokeStyle = colors.fpga;
        ctx.globalAlpha = 0.55;
        ctx.lineWidth = 2;
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        trail.forEach((p, idx) => (idx ? ctx.lineTo(p.x * w, p.y * h) : ctx.moveTo(p.x * w, p.y * h)));
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.globalAlpha = 1;
      }

      // 目标航点标记
      const pulseR = 6 + Math.sin(frameTick * 0.1) * 2.5;
      ctx.strokeStyle = colors.accent;
      ctx.lineWidth = 1.6;
      ctx.beginPath(); ctx.arc(tx, ty, pulseR, 0, Math.PI * 2); ctx.stroke();
      ctx.fillStyle = colors.accent;
      ctx.beginPath(); ctx.arc(tx, ty, 3, 0, Math.PI * 2); ctx.fill();

      // 绘制 BX72 麦轮小车车体
      ctx.save();
      ctx.translate(nrx, nry);
      ctx.rotate(robot.angle);
      // 四个麦轮
      ctx.fillStyle = colors.text;
      [[-9, -10], [4, -10], [-9, 7], [4, 7]].forEach(([wx, wy]) => {
        ctx.beginPath(); ctx.roundRect(wx, wy, 6, 3.2, 1); ctx.fill();
      });
      // 车体
      ctx.fillStyle = colors.bg;
      ctx.strokeStyle = colors.text;
      ctx.lineWidth = 1.8;
      ctx.beginPath(); ctx.roundRect(-11, -8, 22, 16, 4); ctx.fill(); ctx.stroke();
      // 雷达塔 + 车头方向
      ctx.fillStyle = colors.robot;
      ctx.beginPath(); ctx.arc(4, 0, 3.5, 0, Math.PI * 2); ctx.fill();
      ctx.restore();

      requestAnimationFrame(step);
    };

    readTheme();
    fit();
    new ResizeObserver(fit).observe(canvas);
    window.addEventListener('wanone:themechange', readTheme);
    requestAnimationFrame(step);
  });
</script>

<style>
  .lidar-box {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }
  .lidar-box__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-soft);
  }
  .lidar-box__title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .lidar-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-robot);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-robot) 22%, transparent);
  }
  .lidar-box__controls {
    display: flex;
    gap: 6px;
  }
  .mini-btn {
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 11.5px;
    font-weight: 550;
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }
  .mini-btn:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    background: var(--color-surface-hover);
  }

  .lidar-box__stage {
    position: relative;
    height: 310px;
    cursor: crosshair;
  }
  .lidar-box__stage canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .lidar-hud {
    position: absolute;
    left: 12px;
    bottom: 10px;
    display: flex;
    gap: 10px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    border: 1px solid var(--color-border);
    backdrop-filter: blur(8px);
    font-size: 11px;
    color: var(--color-text-muted);
    pointer-events: none;
  }
  .lidar-box__foot {
    padding: 9px 16px;
    border-top: 1px solid var(--color-border);
    font-size: 12px;
    color: var(--color-text-muted);
    background: var(--color-surface);
  }
  .mono {
    font-family: var(--font-mono);
  }
</style>
